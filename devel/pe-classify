# layer 3: output
# --------------------------------------------------------------------------

@dataclass
class Item:
	"""One classified thing: a PE image, or an archive that held some."""
	display: str
	facts: Facts | None = None
	verdict: Verdict | None = None
	archive: ArchiveFacts | None = None
	depth: int = 0


def classify_archive(arc: ArchiveFacts) -> Verdict:
	v = Verdict(target='archive', os_tag='', runtime='', confidence='high')
	v.platform = f'{arc.kind.upper()} archive'
	inst = arc.install
	if arc.error:
		v.platform, v.confidence = arc.error, 'low'
		return v
	if inst is None:
		v.notes.append(f'{len(arc.members)} member(s)')
		return v

	v.platform = f'Windows CE installation CAB ({inst.origin})'
	v.arch, arch_label = PROCESSOR_TYPES.get(inst.processor, ('', f'processor {inst.processor}'))
	v.arch_label = arch_label
	span = f', CE {inst.os_min}-{inst.os_max}' if inst.os_min else ''
	v.evidence.append(f'{inst.origin}: {inst.title or "(unnamed package)"}{span}')
	if inst.certificates:
		stores = sorted({s for s, _ in inst.certificates})
		v.platform = 'Windows Mobile certificate provisioning CAB'
		v.roles.append(f'installs {len(inst.certificates)} certificate(s) into {", ".join(stores)}')
		if any('Privileged' in s or 'SPC' in s for s in stores):
			v.roles.append('grants privileged/software-publisher trust -- device unlock package')
	elif inst.empty and inst.provisioning:
		v.roles.append(f'provisioning only: {", ".join(inst.provisioning)}')
	if inst.processor:
		v.evidence.append(f'ProcessorType {inst.processor} ({arch_label})')
	if inst.unsupported:
		v.evidence.append(f'refuses to install on: {inst.unsupported}')
		if 'HPC' in inst.unsupported.upper() or 'JUPITER' in inst.unsupported.upper():
			v.roles.append('Pocket PC / Windows Mobile package (excludes Handheld PC)')
	keys = '\n'.join(k.lower() for k, _, _, _ in inst.registry)
	for needle, meaning in REGISTRY_HINTS:
		if needle in keys:
			v.roles.append(meaning)
	if any(f.selfreg for f in inst.files):
		v.roles.append('self-registering COM components')
	if arc.setup_dll:
		v.roles.append(f'custom setup DLL ({arc.setup_dll})')
	v.ce_version = inst.os_min
	v.os_tag = f'ce{inst.os_min}' if inst.os_min else ''
	v.notes.extend(inst.warnings)
	return v


ARCHIVE_ONLY_FIELDS = ('appname', 'provider', 'osmin', 'osmax', 'processor',
                       'unsupported', 'members')


def _archive_fields(item: Item) -> dict[str, str]:
	arc, v = item.archive, item.verdict
	inst = arc.install
	out = dict.fromkeys(PE_ONLY_FIELDS, '')
	out.update({
		'target': v.target, 'os': v.os_tag, 'platform': v.platform,
		'arch': v.arch, 'kind': arc.kind, 'runtime': '',
		'ceversion': v.ce_version,
		'appname': inst.appname if inst else '',
		'provider': inst.provider if inst else '',
		'product': inst.title if inst else '',
		'osmin': inst.os_min if inst else '',
		'osmax': inst.os_max if inst else '',
		'processor': str(inst.processor) if inst and inst.processor else '',
		'unsupported': inst.unsupported if inst else '',
		'members': str(len(arc.members)),
	})
	tag = '-'.join(x for x in (out['os'], out['arch']) if x)
	out['tag'] = tag
	return out


def fields(item: Item) -> dict[str, str]:
	"""Flat namespace for --format. Empty string means 'not determined'."""
	if item.archive is not None:
		return _archive_fields(item)
	facts, v = item.facts, item.verdict
	info = facts.version_info
	primary_lang = max(facts.resource_langs,
	                   key=lambda k: sum(facts.resource_langs[k].values())) \
		if facts.resource_langs else None
	when = None
	if 0 < facts.timestamp < 0x7FFFFFFF:
		when = datetime.fromtimestamp(facts.timestamp, timezone.utc)

	out = {
		'target': v.target if v.target != 'unknown' else '',
		'os': v.os_tag,
		'platform': v.platform,
		'runtime': v.runtime if facts.ok else '',
		'arch': v.arch,
		'bits': ('64' if facts.pe32_plus else '32') if facts.ok else '',
		'subsys': SUBSYSTEM_SHORT.get(facts.subsystem, ''),
		'kind': ('dll' if facts.is_dll else 'exe') if facts.ok else '',
		'ceversion': v.ce_version,
		'winversion': v.win_version,
		'netversion': v.net_version,
		'langid': str(primary_lang) if primary_lang else '',
		'lang': lcid_name(primary_lang) if primary_lang else '',
		'company': info.get('CompanyName', ''),
		'product': info.get('ProductName', ''),
		'description': info.get('FileDescription', ''),
		'fileversion': info.get('FileVersion', ''),
		'productversion': info.get('ProductVersion', ''),
		'origname': info.get('OriginalFilename', ''),
		'assembly': facts.net.assembly if facts.net else '',
		'date': when.strftime('%Y-%m-%d') if when else '',
		'year': when.strftime('%Y') if when else '',
	}
	out.update(dict.fromkeys(ARCHIVE_ONLY_FIELDS, ''))
	tag = out['os']
	if tag and out['arch']:
		tag = f'{tag}-{out["arch"]}'
	if tag and v.runtime != 'native' and not out['os'].startswith(('cf', 'wp')):
		tag = f'{tag}-{v.runtime}'
	out['tag'] = tag
	return out


PE_ONLY_FIELDS = (
	'target', 'os', 'platform', 'runtime', 'arch', 'bits', 'subsys', 'kind',
	'ceversion', 'winversion', 'netversion', 'langid', 'lang', 'company',
	'product', 'description', 'fileversion', 'productversion', 'origname',
	'assembly', 'date', 'year', 'tag',
)


class _StrictFormatter(string.Formatter):
	"""Formatter that reports, rather than renders, unresolved fields."""

	def __init__(self, values: dict[str, str]):
		self.values = values
		self.missing: list[str] = []

	def get_value(self, key, args, kwargs):
		if isinstance(key, int):
			self.missing.append(str(key))
			return ''
		value = self.values.get(key)
		if value is None:
			self.missing.append(f'{key} (unknown field)')
			return ''
		if not value:
			self.missing.append(key)
		return value


def render_format(spec: str, values: dict[str, str]) -> str:
	formatter = _StrictFormatter(values)
	try:
		text = formatter.vformat(spec, (), {})
	except (ValueError, KeyError) as exc:
		raise typer.BadParameter(f'bad format string: {exc}') from exc
	return '' if formatter.missing else text


def _md_escape(text: str) -> str:
	return text.replace('|', '\\|').replace('\n', ' ')


def _archive_row(item: Item) -> list[str]:
	arc, v = item.archive, item.verdict
	f = fields(item)
	inst = arc.install
	notes = []
	if inst:
		notes.append(inst.title or '(unnamed package)')
		if inst.unsupported:
			notes.append(f'not for {inst.unsupported}')
	notes.extend(v.roles[:1])
	if not arc.ok:
		notes = [arc.error]
	span = f'{inst.os_min}-{inst.os_max}' if inst and inst.os_min else ''
	return [
		_md_escape(item.display),
		'archive', f['arch'] or '--', arc.kind, '--',
		span or '--', '--', f'{len(arc.members)} members',
		_md_escape('; '.join(notes) or '--'),
	]


def render_table(items: list[Item], base: Path | None) -> str:
	header = ['File', 'Target', 'Arch', 'Runtime', 'Sub', 'OS ver', 'Lang', 'Version', 'Notes']
	lines = ['| ' + ' | '.join(header) + ' |',
	         '|' + '|'.join(['---'] * len(header)) + '|']
	for item in items:
		if item.archive is not None:
			lines.append('| ' + ' | '.join(_archive_row(item)) + ' |')
			continue
		facts, v = item.facts, item.verdict
		f = fields(item)
		notes = []
		if v.roles:
			notes.append(v.roles[0])
		notes.extend(t for t in v.toolchain if t.startswith('packed'))
		if facts.signed_bytes:
			notes.append('signed')
		if not facts.ok:
			notes = [facts.error]
		if v.confidence != 'high' and facts.ok:
			notes.append(f'({v.confidence} confidence)')
		cells = [
			_md_escape(item.display),
			f['target'] or '--',
			f['arch'] or '--',
			f['runtime'] or '--',
			f['subsys'] or '--',
			f['ceversion'] or f['winversion'] or '--',
			f['lang'] or '--',
			_md_escape(f['fileversion'] or f['netversion'] or '--'),
			_md_escape('; '.join(notes) or '--'),
		]
		lines.append('| ' + ' | '.join(cells) + ' |')
	return '\n'.join(lines)


def _kv(console: Console, key: str, value: str, style: str = '') -> None:
	if value:
		console.print(f'    [dim]{key:<14}[/dim] ' + (f'[{style}]{escape(value)}[/{style}]'
		                                             if style else escape(value)))


def render_archive_detail(console: Console, item: Item) -> None:
	arc, v = item.archive, item.verdict
	console.print(f'[bold]{escape(item.display)}[/bold]')
	if not arc.ok:
		console.print(f'    [red]{escape(arc.error)}[/red]\n')
		return
	console.print(f'  [green]{escape(v.platform)}[/green]  '
	              f'[dim]{len(arc.members)} member(s), {arc.size} bytes[/dim]')

	inst = arc.install
	if inst is None:
		console.print('    [dim]no Windows CE installation metadata[/dim]\n')
		return

	console.print('\n  [bold]Evidence[/bold]')
	for line in v.evidence:
		console.print(f'    [dim]·[/dim] {escape(line)}')

	console.print('\n  [bold]Package[/bold]')
	_kv(console, 'name', inst.title)
	_kv(console, 'provider', inst.provider)
	_kv(console, 'metadata', inst.origin)
	if inst.os_min or inst.os_max:
		_kv(console, 'OS versions', f'CE {inst.os_min} .. {inst.os_max}')
	if inst.build_min or inst.build_max:
		_kv(console, 'build range', f'{inst.build_min} .. {inst.build_max}')
	for store, thumb in inst.certificates:
		_kv(console, 'certificate', f'{store}: {thumb}')
	if inst.processor:
		_kv(console, 'processor', f'{inst.processor} ({v.arch_label})')
	_kv(console, 'not supported', inst.unsupported)
	_kv(console, 'setup DLL', arc.setup_dll)
	for role in v.roles:
		_kv(console, 'role', role)

	if inst.dirs:
		console.print('\n  [bold]Install directories[/bold]')
		for d in inst.dirs:
			console.print(f'      {escape(d)}')

	if inst.files:
		console.print('\n  [bold]Payload[/bold]  [dim](archive member -> installed path)[/dim]')
		for cf in inst.files:
			mark = ' [dim]self-register[/dim]' if cf.selfreg else ''
			console.print(f'      [dim]{escape(cf.source):>6}[/dim]  {escape(cf.installed)}{mark}')

	if inst.shortcuts:
		console.print('\n  [bold]Shortcuts[/bold]')
		for link, target in inst.shortcuts:
			console.print(f'      {escape(link)} [dim]->[/dim] {escape(target)}')

	if inst.registry:
		console.print('\n  [bold]Registry[/bold]')
		for key, name, rtype, value in inst.registry:
			where = escape(f'{key}\\{name}')
			console.print(f'      {where}  [dim]{rtype}[/dim] = {escape(value[:80])}')

	for note in v.notes:
		console.print(f'    [yellow]![/yellow] {escape(note)}')
	console.print()


def render_detail(console: Console, item: Item, show_strings: int) -> None:
	if item.archive is not None:
		render_archive_detail(console, item)
		return
	facts, v = item.facts, item.verdict
	f = fields(item)
	console.print(f'[bold]{escape(item.display)}[/bold]')
	if not facts.ok:
		console.print(f'    [red]{escape(facts.error)}[/red]\n')
		return

	colour = {'high': 'green', 'medium': 'yellow', 'low': 'red'}[v.confidence]
	summary = ' · '.join(x for x in (v.platform, v.runtime_label, v.arch_label,
	                                 SUBSYSTEMS.get(facts.subsystem, '?')) if x)
	console.print(f'  [{colour}]{escape(summary)}[/{colour}]  [dim]({v.confidence} confidence)[/dim]')

	console.print('\n  [bold]Evidence[/bold]')
	for line in v.evidence or ['(none)']:
		console.print(f'    [dim]·[/dim] {escape(line)}')

	console.print('\n  [bold]Image[/bold]')
	_kv(console, 'machine', f'0x{facts.machine:04X}  {v.arch_label}')
	_kv(console, 'subsystem', f'{facts.subsystem}  {SUBSYSTEMS.get(facts.subsystem, "?")}'
	                          f'  (version {facts.subsys_ver[0]}.{facts.subsys_ver[1]:02d})')
	_kv(console, 'min OS', '{}.{:02d}'.format(*facts.os_ver))
	_kv(console, 'characteristics', 'DLL' if facts.is_dll else 'executable')
	_kv(console, 'magic', 'PE32+' if facts.pe32_plus else 'PE32')
	_kv(console, 'timestamp', f'{f["date"]} ({facts.timestamp:#x})' if f['date']
	    else f'{facts.timestamp:#x} (zeroed or non-time)')
	_kv(console, 'size', f'{facts.size} bytes')
	_kv(console, 'sections', ' '.join(facts.sections))
	for line in v.toolchain:
		_kv(console, '', line)

	if facts.net:
		console.print('\n  [bold]Managed metadata[/bold]')
		_kv(console, 'CLR header', facts.net.metadata_version)
		_kv(console, 'assembly', f'{facts.net.assembly} {facts.net.assembly_version}'.strip())
		_kv(console, 'flags', ', '.join(x.removeprefix('CLR_') for x in facts.net.flags))
		_kv(console, 'target fw', facts.net.tfm)
		for name, version, token, retarget in facts.net.refs:
			origin = NET_TOKENS.get(token, '')
			suffix = f'  [dim]{origin}[/dim]' if origin else ''
			flag = ' [dim]retargetable[/dim]' if retarget else ''
			console.print(f'      {escape(name)} {version}'
			              f'{" " + token if token else ""}{flag}{suffix}')

	if facts.libs:
		console.print('\n  [bold]Imports[/bold]')
		for lib in sorted(facts.imports):
			info = LIBS.get(lib)
			note = f'  [dim]{info[1]}[/dim]' if info else ''
			console.print(f'      {escape(lib)} [dim]({facts.imports[lib]})[/dim]{note}')
		for lib in sorted(facts.delay_imports):
			console.print(f'      {escape(lib)} [dim](delay-loaded)[/dim]')

	if facts.exports:
		console.print('\n  [bold]Exports[/bold]')
		shown = facts.exports[:12]
		_kv(console, 'module', facts.export_name)
		console.print('      ' + escape(', '.join(shown))
		              + (f' [dim]... +{len(facts.exports) - len(shown)} more[/dim]'
		                 if len(facts.exports) > len(shown) else ''))

	if v.capabilities or v.roles:
		console.print('\n  [bold]Inferred[/bold]')
		_kv(console, 'capabilities', ', '.join(v.capabilities))
		for role in v.roles:
			_kv(console, 'role', role)

	if facts.version_info:
		console.print('\n  [bold]Version info[/bold]')
		for key, value in facts.version_info.items():
			_kv(console, key, value)
		for lang, codepage in facts.translations:
			_kv(console, 'translation',
			    f'{lcid_name(lang)} (0x{lang:04X}) / {CODEPAGES.get(codepage, codepage)}')

	if facts.resource_langs:
		console.print('\n  [bold]Resources[/bold]')
		_kv(console, 'types', ', '.join(sorted(set(facts.resource_types))))
		for lang in sorted(facts.resource_langs):
			kinds = facts.resource_langs[lang]
			detail = ' '.join(f'{k.removeprefix("RT_")}({n})' for k, n in sorted(kinds.items()))
			strings = facts.string_tables.get(lang)
			count = f'  [dim]{len(strings)} strings[/dim]' if strings else ''
			console.print(f'      [bold]{lcid_name(lang):<14}[/bold] '
			              f'[dim]0x{lang:04X}[/dim]  {escape(detail)}{count}')
			if strings and show_strings:
				for text in strings[:show_strings]:
					console.print(f'        [dim]|[/dim] {escape(text[:100])}')

	if v.notes:
		console.print('\n  [bold]Notes[/bold]')
		for note in v.notes:
			console.print(f'    [yellow]![/yellow] {escape(note)}')
	console.print()


