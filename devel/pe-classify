@dataclass
class Verdict:
	target: str = 'unknown'          # windows-mobile | windows-ce | windows-desktop
	os_tag: str = ''                 # wm6, wm2003, win32, ...
	platform: str = ''               # human-readable target
	runtime: str = 'native'          # native | netcf | netfx | netcore | silverlight
	runtime_label: str = ''
	arch: str = ''
	arch_label: str = ''
	confidence: str = 'high'         # high | medium | low
	evidence: list[str] = field(default_factory=list)
	capabilities: list[str] = field(default_factory=list)
	roles: list[str] = field(default_factory=list)
	toolchain: list[str] = field(default_factory=list)
	notes: list[str] = field(default_factory=list)
	ce_version: str = ''
	win_version: str = ''
	net_version: str = ''


def _classify_net(facts: Facts, v: Verdict) -> None:
	net = facts.net
	if net is None:
		v.runtime = 'netfx'
		v.runtime_label = 'managed (.NET, metadata unreadable)'
		v.confidence = 'low'
		v.evidence.append('CLR data directory present but metadata could not be parsed')
		return

	tokens = net.tokens
	mscorlib = net.ref('mscorlib')
	corelib_token = mscorlib[2] if mscorlib else ''

	if CF_TOKEN in tokens:
		v.runtime = 'netcf'
		base = '1.0' if (mscorlib and mscorlib[1] == '1.0.5000.0') else '2.0'
		if any(r[2] == CF_TOKEN and r[1].startswith('3.5') for r in net.refs):
			base = '3.5'
		if 'CompactFramework,Version=v3.5' in net.tfm:
			base = '3.5'
		v.net_version = f'cf{base}'
		v.runtime_label = f'.NET Compact Framework {base}'
		v.evidence.append(f'assembly references carry public key token {CF_TOKEN} (.NET CF)')
		if net.ref('Microsoft.WindowsCE.Forms'):
			v.evidence.append('references Microsoft.WindowsCE.Forms (device UI)')
		if base == '2.0':
			v.notes.append('CF 2.0 and CF 3.5 both ship mscorlib 2.0.0.0; '
			               'absent a 3.5-versioned reference the two are indistinguishable')
	elif SILVERLIGHT_TOKEN in tokens:
		v.runtime = 'silverlight'
		v.net_version = 'silverlight'
		v.runtime_label = 'Silverlight / Windows Phone 7'
		v.evidence.append(f'assembly references carry public key token {SILVERLIGHT_TOKEN}')
	else:
		v.runtime = 'netfx'
		base = CLR_METADATA_VERSIONS.get(net.metadata_version, net.metadata_version or '?')
		if CORE_TOKEN in tokens or net.ref('netstandard') or net.ref('System.Runtime'):
			v.runtime = 'netcore'
			base = 'core'
		elif any(r[0] == 'System.Core' and r[1].startswith('3.5') for r in net.refs):
			base = '3.5'
		elif any(r[0] in ('PresentationCore', 'PresentationFramework', 'WindowsBase')
		         and r[1].startswith('3.0') for r in net.refs):
			base = '3.0'
		if net.tfm.startswith('.NETFramework,Version=v'):
			base = net.tfm.split('=v', 1)[1]
		v.net_version = base
		v.runtime_label = ('.NET Core / .NET 5+' if v.runtime == 'netcore'
		                   else f'.NET Framework {base}')
		if corelib_token:
			v.evidence.append(f'mscorlib public key token {corelib_token} '
			                  f'({NET_TOKENS.get(corelib_token, "unknown key")})')


def _classify_platform(facts: Facts, v: Verdict) -> None:
	libs = facts.libs
	ce_libs = libs & CE_MARKER_LIBS
	wm_libs = libs & WM_MARKER_LIBS
	win32_libs = libs & WIN32_MARKER_LIBS
	ce_subsystem = facts.subsystem == 9
	ce_resource = 'CEUX' in facts.resource_types

	if ce_subsystem:
		v.evidence.append('PE subsystem 9 (IMAGE_SUBSYSTEM_WINDOWS_CE_GUI)')
	if ce_libs:
		v.evidence.append(f'imports CE-only libraries: {", ".join(sorted(ce_libs))}')
	if wm_libs:
		v.evidence.append(f'imports Windows Mobile shell libraries: {", ".join(sorted(wm_libs))}')
	if ce_resource:
		v.evidence.append('carries a CEUX resource (Windows CE shell metadata)')
	if facts.machine in CE_ONLY_MACHINES:
		v.evidence.append(f'machine 0x{facts.machine:04X} only ever shipped on Windows CE devices')

	ce_score = sum((ce_subsystem, bool(ce_libs), ce_resource, facts.machine in CE_ONLY_MACHINES))

	if v.runtime in ('netcf', 'silverlight'):
		v.target = 'windows-mobile'
		v.platform = ('Windows Mobile / Windows CE device (managed)'
		              if v.runtime == 'netcf' else 'Windows Phone 7 / Silverlight')
		v.os_tag = v.net_version if v.runtime == 'netcf' else 'wp7'
		if not ce_subsystem:
			v.notes.append('managed device assemblies keep a desktop subsystem value; '
			               'the target is inferred from the framework, not the PE header')
		return

	if ce_score:
		major, minor = _ce_version(*facts.subsys_ver)
		tag, label = CE_VERSIONS.get((major, minor), ('ce', f'Windows CE {major}.{minor}'))
		v.ce_version = f'{major}.{minor}'
		if wm_libs or ce_resource:
			v.target = 'windows-mobile'
			v.platform = label if tag.startswith(('ppc', 'wm')) else f'{label}, Windows Mobile shell'
			v.os_tag = tag
		else:
			v.target = 'windows-ce'
			v.platform = label
			v.os_tag = tag
		if ce_score == 1:
			v.confidence = 'medium'
		if win32_libs:
			v.notes.append(f'also imports desktop-only {", ".join(sorted(win32_libs))} -- '
			               'unusual, check for a patched or hand-built image')
		return

	v.target = 'windows-desktop'
	v.os_tag = 'win64' if facts.pe32_plus else 'win32'
	built_for = WIN_VERSIONS.get(facts.subsys_ver)
	v.win_version = '{}.{:02d}'.format(*facts.subsys_ver)
	v.platform = f'Windows desktop ({"64-bit" if facts.pe32_plus else "32-bit"})'
	if built_for:
		v.evidence.append(f'subsystem version {v.win_version} -- {built_for}')
	if not win32_libs and not facts.has_clr:
		v.confidence = 'medium'
		v.notes.append('no recognisable Win32 core imports; may be packed or driver-like')


def _classify_extras(facts: Facts, v: Verdict) -> None:
	caps, notes = set(), []
	for lib in sorted(facts.libs):
		info = LIBS.get(lib)
		if info:
			caps.add(info[0])
		elif BORLAND_RE.match(lib):
			caps.add('borland')
			notes.append(f'Borland Delphi / C++ Builder runtime package ({lib})')
	caps.discard('win32-core')
	caps.discard('ce-core')
	v.capabilities = sorted(caps)

	exported = set(facts.exports)
	for symbol, role in EXPORT_ROLES.items():
		if symbol in exported:
			v.roles.append(role)
	if facts.is_dll and any(e.endswith('_IOControl') for e in exported) \
			and any(e.endswith('_Init') for e in exported):
		v.roles.append('Windows CE stream driver')
	if 'installer' in caps and facts.embedded_cabs:
		v.roles.append('installer carrying embedded CAB payload')
	if 'activesync' in caps:
		v.roles.append('desktop-side device companion (RAPI/ActiveSync)')
	if facts.is_dll and not facts.libs and not exported and facts.resource_langs:
		v.roles.append('resource-only module (satellite / MUI localisation)')
		notes.append('resource-only modules are built machine-neutral; the machine field '
		             'does not describe the device they belong to')

	packer = next((PACKERS[s] for s in facts.sections if s in PACKERS), '')
	if packer:
		v.toolchain.append(f'packed with {packer}')
		v.confidence = 'medium' if v.confidence == 'high' else v.confidence
		notes.append('image is packed; imports and resources reflect the stub, not the payload')

	era = LINKER_ERAS.get(facts.linker[0])
	v.toolchain.append('linker {}.{:02d}{}'.format(
		*facts.linker, f' -- {era}' if era else ''))
	if facts.pdb_path:
		v.toolchain.append(f'PDB path: {facts.pdb_path}')
	if facts.signed_bytes:
		v.toolchain.append(f'Authenticode signature present ({facts.signed_bytes} bytes)')
	if facts.embedded_cabs:
		notes.append(f'{facts.embedded_cabs} embedded CAB header(s) (MSCF) found in the image')
	if facts.overlay:
		notes.append(f'{facts.overlay} bytes of overlay data past the last section')

	v.roles = list(dict.fromkeys(v.roles))
	v.notes.extend(notes)


def classify(facts: Facts) -> Verdict:
	"""Decision tree over extracted facts. Runtime first: managed device
	assemblies carry a desktop subsystem value, so the PE header alone would
	misfile every .NET CF binary as Win32."""
	v = Verdict()
	if not facts.ok:
		v.target = 'unknown'
		v.platform = facts.error
		v.confidence = 'low'
		return v

	v.arch, v.arch_label = MACHINES.get(facts.machine, ('', f'unknown (0x{facts.machine:04X})'))
	if facts.has_clr:
		_classify_net(facts, v)
		if facts.net and 'CLR_ILONLY' in facts.net.flags and facts.machine == 0x014C:
			v.arch, v.arch_label = 'msil', 'MSIL (architecture-neutral IL)'
	else:
		v.runtime_label = 'native'

	_classify_platform(facts, v)
	_classify_extras(facts, v)
	return v


