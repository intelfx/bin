def _ce_version(major: int, minor: int) -> tuple[int, int]:
	"""Normalise the two CE spellings of a subsystem minor version."""
	if major >= 3 and minor in (10, 20, 30):
		minor //= 10
	return (major, minor)


def lcid_name(lcid: int) -> str:
	if lcid in LCIDS:
		return LCIDS[lcid]
	primary = PRIMARY_LANGS.get(lcid & 0x3FF)
	return f'{primary}-?' if primary else f'0x{lcid:04X}'


