app = typer.Typer(add_completion=False, no_args_is_help=True,
                  context_settings={'help_option_names': ['-h', '--help']})

FIELD_HELP = (
	'target os platform runtime arch bits subsys kind ceversion winversion '
	'netversion lang langid company product description fileversion '
	'productversion origname assembly date year tag'
)


def _collect(paths: list[Path]) -> Iterator[Path]:
	for path in paths:
		if str(path) == '-':
			for line in sys.stdin:
				line = line.strip()
				if line:
					yield Path(line)
		elif path.is_dir():
			for child in sorted(path.rglob('*')):
				try:
					if child.is_file():
						yield child
				except OSError as exc:
					log.warning('cannot stat', path=str(child), error=str(exc))
		else:
			yield path


@app.command()
def main(
	paths: Annotated[list[Path], typer.Argument(
		help='Files to classify; a directory is walked recursively, "-" reads paths from stdin.')],
	fmt: Annotated[str, typer.Option(
		'--format', '-f',
		help=f'Emit a format string per file instead of a report. '
		     f'Empty output if any referenced field is unknown. Fields: {FIELD_HELP}')] = '',
	table: Annotated[bool, typer.Option('--table/--detail', '-t/-d',
		help='Force markdown table or detailed report (default: table for >1 file).')] = None,
	strings: Annotated[int, typer.Option('--strings', '-s',
		help='Show up to N sample strings per resource language.')] = 0,
	relative: Annotated[bool, typer.Option('--relative/--absolute',
		help='Print paths relative to the current directory in table mode.')] = True,
	skip_non_pe: Annotated[bool, typer.Option('--skip-non-pe',
		help='Omit files that are not PE images instead of reporting them.')] = False,
	verbose: Annotated[bool, typer.Option('--verbose', '-v', help='Log parser diagnostics.')] = False,
) -> None:
	"""Classify Windows PE binaries by target platform and runtime."""
	structlog.configure(
		processors=[structlog.processors.add_log_level,
		            structlog.dev.ConsoleRenderer(colors=sys.stderr.isatty())],
		logger_factory=structlog.PrintLoggerFactory(sys.stderr),
		wrapper_class=structlog.make_filtering_bound_logger(
			logging.DEBUG if verbose else logging.ERROR),
	)
	if not verbose:
		for name in ('dnfile', 'pefile'):
			logging.getLogger(name).setLevel(logging.CRITICAL)

	results = []
	for path in _collect(paths):
		facts = probe(path)
		if skip_non_pe and not facts.ok:
			continue
		results.append((path, facts, classify(facts)))

	if not results:
		raise typer.Exit(1)

	if fmt:
		for _, facts, v in results:
			print(render_format(fmt, fields(facts, v)))
		return

	if table if table is not None else len(results) > 1:
		print(render_table(results, Path.cwd() if relative else None))
		return

	console = Console(highlight=False, soft_wrap=True)
	for _, facts, v in results:
		render_detail(console, facts, v, strings)


if __name__ == '__main__':
	app()
