# CLI
# --------------------------------------------------------------------------

app = typer.Typer(add_completion=False, no_args_is_help=True,
                  context_settings={'help_option_names': ['-h', '--help']})

FIELD_HELP = (
	'target os platform runtime arch bits subsys kind ceversion winversion '
	'netversion lang langid company product description fileversion '
	'productversion origname assembly date year tag; for archives also '
	'appname provider osmin osmax processor unsupported members'
)

EXTRACT_TIMEOUT = 600


def analyse(path: Path, display: str, scratch: Scratch, opts: 'Options',
            depth: int = 0) -> Iterator[Item]:
	"""Classify one file, descending into it when it is an archive."""
	kind = archive_kind(path) if depth < opts.max_depth else ''
	if not kind:
		facts = probe(path)
		if facts.ok or not opts.skip_non_pe:
			yield Item(display=display, facts=facts, verdict=classify(facts), depth=depth)
		return

	# a CAB is worth unpacking even when not descending -- its install header
	# is the metadata we came for; other containers are just lids
	if opts.recurse or kind == 'cab':
		arc = probe_archive(path, kind, scratch, next(opts.serial))
	else:
		arc = ArchiveFacts(path=path, kind=kind, size=path.stat().st_size)

	item = Item(display=display, archive=arc, verdict=classify_archive(arc), depth=depth)
	if arc.ok or not opts.skip_non_pe:
		yield item
	if not arc.ok or not opts.recurse:
		if arc.root:
			shutil.rmtree(arc.root, ignore_errors=True)
		return

	# prefer the installed name over the mangled archive member name
	sources = arc.install.source_map() if arc.install else {}
	try:
		for member in arc.members:
			if member in arc.metadata:
				continue
			rel = member.relative_to(arc.root)
			entry = sources.get(member.suffix.upper()) or sources.get(str(rel).upper())
			label = entry.installed if entry else str(rel)
			yield from analyse(member, f'{display}!/{label}', scratch, opts, depth + 1)
	finally:
		# bound peak scratch usage; the namespace would reclaim it at exit anyway
		shutil.rmtree(arc.root, ignore_errors=True)


@dataclass
class Options:
	recurse: bool = True
	max_depth: int = 3
	skip_non_pe: bool = False
	serial: Iterator[int] = field(default_factory=lambda: iter(range(1 << 30)))


def _collect(paths: list[Path]) -> Iterator[Path]:
	for path in paths:
		if str(path) == '-':
			for line in sys.stdin:
				line = line.strip()
				if line:
					yield Path(line)
		elif path.is_dir():
			for child in sorted(path.rglob('*')):
				try:
					if child.is_file():
						yield child
				except OSError as exc:
					log.warning('cannot stat', path=str(child), error=str(exc))
		else:
			yield path


@app.command()
def main(
	paths: Annotated[list[Path], typer.Argument(
		help='Files to classify; a directory is walked recursively, "-" reads paths from stdin.')],
	fmt: Annotated[str, typer.Option(
		'--format', '-f',
		help=f'Emit a format string per file instead of a report. '
		     f'Empty output if any referenced field is unknown. Fields: {FIELD_HELP}')] = '',
	table: Annotated[bool, typer.Option('--table/--detail', '-t/-d',
		help='Force markdown table or detailed report (default: table for >1 file).')] = None,
	strings: Annotated[int, typer.Option('--strings', '-s',
		help='Show up to N sample strings per resource language.')] = 0,
	relative: Annotated[bool, typer.Option('--relative/--absolute',
		help='Print paths relative to the current directory in table mode.')] = True,
	skip_non_pe: Annotated[bool, typer.Option('--skip-non-pe',
		help='Omit files that are neither PE images nor readable archives.')] = False,
	recurse: Annotated[bool, typer.Option('--recurse/--no-recurse', '-r/-R',
		help='Unpack CAB/ZIP/RAR/7z archives and classify what is inside '
		     '(default: on, except with --format, whose subject is the named file).')] = None,
	max_depth: Annotated[int, typer.Option('--max-depth',
		help='How deep to follow archives nested inside archives.')] = 3,
	verbose: Annotated[bool, typer.Option('--verbose', '-v', help='Log parser diagnostics.')] = False,
) -> None:
	"""Classify Windows PE binaries by target platform and runtime.

	Archives are unpacked into a private tmpfs inside an unshared mount
	namespace, so nothing reaches the filesystem and nothing needs cleaning up.
	Windows CE installation CABs additionally report their install metadata:
	target OS range, processor, payload mapping, registry keys and shortcuts.
	"""
	structlog.configure(
		processors=[structlog.processors.add_log_level,
		            structlog.dev.ConsoleRenderer(colors=sys.stderr.isatty())],
		logger_factory=structlog.PrintLoggerFactory(sys.stderr),
		wrapper_class=structlog.make_filtering_bound_logger(
			logging.DEBUG if verbose else logging.ERROR),
	)
	if not verbose:
		for name in ('dnfile', 'pefile'):
			logging.getLogger(name).setLevel(logging.CRITICAL)

	if recurse is None:
		recurse = not fmt
	opts = Options(recurse=recurse, max_depth=max_depth, skip_non_pe=skip_non_pe)
	scratch = Scratch()
	base = Path.cwd() if relative else None

	results: list[Item] = []
	for path in _collect(paths):
		shown = path.relative_to(base) if base and path.is_relative_to(base) else path
		results.extend(analyse(path, str(shown), scratch, opts))

	if not results:
		raise typer.Exit(1)

	if fmt:
		for item in results:
			print(render_format(fmt, fields(item)))
		return

	if table if table is not None else len(results) > 1:
		print(render_table(results, base))
		return

	console = Console(highlight=False, soft_wrap=True)
	for item in results:
		render_detail(console, item, strings)


if __name__ == '__main__':
	app()
