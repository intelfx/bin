@dataclass
class NetFacts:
	metadata_version: str = ''
	flags: list[str] = field(default_factory=list)
	assembly: str = ''
	assembly_version: str = ''
	# (name, version, public key token, retargetable)
	refs: list[tuple[str, str, str, bool]] = field(default_factory=list)
	tfm: str = ''

	def ref(self, name: str) -> tuple[str, str, str, bool] | None:
		for r in self.refs:
			if r[0].lower() == name.lower():
				return r
		return None

	@property
	def tokens(self) -> set[str]:
		return {r[2] for r in self.refs if r[2]}


