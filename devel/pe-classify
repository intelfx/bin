CLONE_NEWNS, CLONE_NEWUSER = 0x00020000, 0x10000000
MS_REC, MS_PRIVATE = 0x4000, 0x40000


class Scratch:
	"""Somewhere to unpack archives that needs no tearing down.

	Unshares a user and a mount namespace and lays a private tmpfs over the
	temporary directory. Everything written there is unreachable from the rest
	of the system and is destroyed by the kernel when this process exits, so
	there is nothing to unwind on the way out -- no unmount, no rmtree, no
	handler that has to survive a crash or a signal.

	Falls back to an ordinary temporary directory when unprivileged user
	namespaces are unavailable; that path does need explicit cleanup.
	"""

	def __init__(self) -> None:
		self._root: Path | None = None
		self._fallback: tempfile.TemporaryDirectory | None = None
		self.isolated = False

	@staticmethod
	def _mount(src: str | None, target: str, fstype: str | None,
	           flags: int = 0, data: str | None = None) -> None:
		libc = ctypes.CDLL(ctypes.util.find_library('c'), use_errno=True)
		enc = lambda s: s.encode() if s else None
		if libc.mount(enc(src), enc(target), enc(fstype), ctypes.c_ulong(flags), enc(data)) != 0:
			err = ctypes.get_errno()
			raise OSError(err, f'mount {fstype} on {target}: {os.strerror(err)}')

	def _unshare(self) -> Path:
		uid, gid = os.getuid(), os.getgid()
		os.unshare(CLONE_NEWUSER | CLONE_NEWNS)
		# map our own identity rather than root: the unsharer holds full
		# capabilities in the new namespace either way, and keeping the uid
		# means extracted files get the ownership they would have had anyway
		Path('/proc/self/setgroups').write_text('deny')
		Path('/proc/self/uid_map').write_text(f'{uid} {uid} 1')
		Path('/proc/self/gid_map').write_text(f'{gid} {gid} 1')
		base = tempfile.gettempdir()
		self._mount(None, '/', None, MS_REC | MS_PRIVATE)
		self._mount('pe-classify', base, 'tmpfs', 0, 'mode=0700')
		self.isolated = True
		return Path(tempfile.mkdtemp(prefix='pe-classify-'))

	@property
	def root(self) -> Path:
		if self._root is None:
			try:
				self._root = self._unshare()
			except Exception as exc:
				log.warning('namespace isolation unavailable, using a plain temporary '
				            'directory', error=str(exc))
				self._fallback = tempfile.TemporaryDirectory(prefix='pe-classify-')
				self._root = Path(self._fallback.name)
		return self._root


@dataclass
class CabFile:
	source: str = ''        # name inside the CAB, e.g. SKYPES~2.999
	name: str = ''          # name once installed
	dest: str = ''          # destination directory
	flags: int = 0

	@property
	def selfreg(self) -> bool:
		return bool(self.flags & MSCE_FILE_SELFREG)

	@property
	def installed(self) -> str:
		return f'{self.dest}\\{self.name}' if self.dest else self.name


@dataclass
class CabInstall:
	origin: str = ''                # 'MSCE' / 'CE4+' / '_setup.xml'
	appname: str = ''
	provider: str = ''
	os_min: str = ''
	os_max: str = ''
	build_min: int = 0
	build_max: int = 0
	processor: int = 0
	unsupported: str = ''
	files: list[CabFile] = field(default_factory=list)
	dirs: list[str] = field(default_factory=list)
	# (key path, value name, type, value)
	registry: list[tuple[str, str, str, str]] = field(default_factory=list)
	# (shortcut path, target)
	shortcuts: list[tuple[str, str]] = field(default_factory=list)
	# top-level provisioning characteristics, for CABs that install no files
	provisioning: list[str] = field(default_factory=list)
	# (certificate store, thumbprint)
	certificates: list[tuple[str, str]] = field(default_factory=list)
	warnings: list[str] = field(default_factory=list)

	@property
	def empty(self) -> bool:
		return not (self.files or self.registry or self.shortcuts or self.certificates)

	@property
	def title(self) -> str:
		return ' '.join(x for x in (self.provider, self.appname) if x)

	def source_map(self) -> dict[str, CabFile]:
		return {f.source.upper(): f for f in self.files if f.source}


def _ce_path(text: str) -> str:
	"""Expand %CEnn% destination folder ids."""
	def sub(m):
		folder = CE_FOLDERS.get(int(m.group(1)))
		return folder if folder else m.group(0)
	return re.sub(r'%CE(\d+)%', sub, text)


def parse_msce(data: bytes) -> CabInstall:
	"""Decode the cabwiz installation header (the .000 member of a CE CAB).

	Section offsets are authoritative and counts are advisory: repacked CABs
	are common in the wild and routinely under-report their entry counts,
	while the offsets stay correct. An absent section has offset zero.
	"""
	if data[:4] not in MSCE_SIGNATURES:
		raise ValueError('not a Windows CE setup header')
	length, processor = struct.unpack_from('<I', data, 0x08)[0], struct.unpack_from('<I', data, 0x14)[0]
	vmin_hi, vmin_lo, vmax_hi, vmax_lo, build_min, build_max = struct.unpack_from('<6i', data, 0x18)
	offsets = struct.unpack_from('<6I', data, 0x3C)
	oapp, lapp, oprov, lprov, ouns, luns = struct.unpack_from('<6H', data, 0x54)

	inst = CabInstall(origin=data[:4].decode('ascii'),
	                  os_min=f'{vmin_hi}.{vmin_lo}', os_max=f'{vmax_hi}.{vmax_lo}',
	                  build_min=build_min, build_max=build_max, processor=processor)
	if length != len(data):
		inst.warnings.append(f'header declares {length} bytes, file is {len(data)}')

	text = lambda off, ln: data[off:off + ln].split(b'\0')[0].decode('latin-1') if ln else ''
	inst.appname, inst.provider = text(oapp, lapp), text(oprov, lprov)
	inst.unsupported = text(ouns, luns)

	# an absent section's bound is the next section that is present
	ends = [next((x for x in offsets[i + 1:] if x), len(data)) for i in range(6)]
	ostr, odir, ofile, ohive, okey, olink = offsets

	def ids(off: int, ln: int) -> list[int]:
		return [i for i in struct.unpack_from(f'<{ln // 2}H', data, off) if i]

	strings: dict[int, str] = {}
	o = ostr
	while ostr and o < ends[0]:
		sid, ln = struct.unpack_from('<HH', data, o)
		o += 4
		strings[sid] = data[o:o + ln].split(b'\0')[0].decode('latin-1')
		o += ln
	join = lambda seq: '\\'.join(strings.get(i, f'%{i}%') for i in seq)

	dirs: dict[int, str] = {}
	o = odir
	while odir and o < ends[1]:
		did, ln = struct.unpack_from('<HH', data, o)
		o += 4
		dirs[did] = _ce_path(join(ids(o, ln)))
		o += ln
	inst.dirs = sorted(set(dirs.values()))

	o = ofile
	while ofile and o < ends[2]:
		fid, did, _, flags, ln = struct.unpack_from('<HHHIH', data, o)
		o += 12
		name = data[o:o + ln].split(b'\0')[0].decode('latin-1')
		o += ln
		inst.files.append(CabFile(source=f'.{fid:03d}', name=name,
		                          dest=dirs.get(did, ''), flags=flags))

	hives: dict[int, str] = {}
	o = ohive
	while ohive and o < ends[3]:
		hid, root, _, ln = struct.unpack_from('<HHHH', data, o)
		o += 8
		hives[hid] = REGISTRY_ROOTS.get(root, f'#{root}') + '\\' + join(ids(o, ln))
		o += ln

	o = okey
	while okey and o < ends[4]:
		_, hid, _, _, dtype, ln = struct.unpack_from('<6H', data, o)
		o += 12
		name, _, raw = data[o:o + ln].partition(b'\0')
		o += ln
		if dtype == 1 and len(raw) >= 4:
			value = str(struct.unpack_from('<I', raw)[0])
		else:
			value = raw.split(b'\0')[0].decode('latin-1')
		inst.registry.append((hives.get(hid, f'#{hid}'),
		                      name.decode('latin-1') or '(default)',
		                      REGISTRY_TYPES.get(dtype, f'type {dtype}'), value))

	# the trailing section has no following offset to bound it, so honour the
	# declared count there rather than reading into any padding
	nlink = struct.unpack_from('<H', data, 0x3A)[0]
	o = olink
	while olink and o < ends[5] and len(inst.shortcuts) < nlink:
		_, _, base, target, _, ln = struct.unpack_from('<6H', data, o)
		o += 12
		name = join(ids(o, ln))
		o += ln
		folder = CE_FOLDERS.get(base, f'%CE{base}%')
		where = next((f.installed for f in inst.files if f.source == f'.{target:03d}'), f'#{target}')
		inst.shortcuts.append((f'{folder}\\{name}', where))
	return inst


def parse_setup_xml(data: bytes) -> CabInstall:
	"""Decode the WAP provisioning document used by Windows Mobile 5+ CABs."""
	root = ElementTree.fromstring(data)
	inst = CabInstall(origin='_setup.xml')
	params: dict[str, str] = {}
	for char in root.iter('characteristic'):
		if char.get('type') == 'Install':
			for parm in char.findall('parm'):
				params[parm.get('name', '')] = parm.get('value', '')
	inst.appname = params.get('AppName', '')
	inst.os_min, inst.os_max = params.get('OSVersionMin', ''), params.get('OSVersionMax', '')
	inst.build_min = int(params.get('BuildNumberMin') or 0)
	inst.build_max = int(params.get('BuildNumberMax') or 0)
	if params.get('InstallDir'):
		inst.dirs.append(_ce_path(params['InstallDir']))

	def walk(node, path: str) -> None:
		for child in node.findall('characteristic'):
			kind = child.get('type', '')
			if kind in ('MakeDir', 'Extract', 'Shortcut'):
				continue
			here = f'{path}\\{kind}' if path and not kind.startswith('%') else kind
			extract = child.find('characteristic[@type="Extract"]')
			shortcut = child.find('characteristic[@type="Shortcut"]')
			if extract is not None:
				source = extract.find('parm[@name="Source"]')
				flags = MSCE_FILE_SELFREG if extract.find(
					'characteristic[@type="SelfRegister"]') is not None \
					or extract.find('parm[@name="SelfRegister"]') is not None else 0
				inst.files.append(CabFile(source=source.get('value', '') if source is not None else '',
				                          name=kind, dest=_ce_path(path), flags=flags))
			elif shortcut is not None:
				target = shortcut.find('parm[@name="Source"]')
				inst.shortcuts.append((_ce_path(f'{path}\\{kind}'),
				                       _ce_path(target.get('value', '')) if target is not None else ''))
			else:
				if child.find('characteristic[@type="MakeDir"]') is not None:
					inst.dirs.append(_ce_path(here))
				walk(child, here)

	inst.provisioning = sorted({c.get('type', '') for c in root.findall('characteristic')})
	for store in root.iter('characteristic'):
		if store.get('type') != 'CertificateStore':
			continue
		for named in store.findall('characteristic'):
			for cert in named.findall('characteristic'):
				inst.certificates.append((named.get('type', ''), cert.get('type', '')))

	for char in root.iter('characteristic'):
		if char.get('type') == 'FileOperation':
			walk(char, '')
		elif char.get('type') == 'Registry':
			for key in char.findall('characteristic'):
				for parm in key.findall('parm'):
					inst.registry.append((
						_ce_path(key.get('type', '')), parm.get('name', '') or '(default)',
						'REG_DWORD' if parm.get('datatype') == 'integer' else 'REG_SZ',
						parm.get('value', '')))
	inst.dirs = sorted(set(inst.dirs))
	return inst


@dataclass
class ArchiveFacts:
	path: Path
	kind: str = ''
	size: int = 0
	error: str = ''
	root: Path | None = None
	members: list[Path] = field(default_factory=list)
	install: CabInstall | None = None
	setup_dll: str = ''
	# members consumed as install metadata rather than payload
	metadata: list[Path] = field(default_factory=list)

	@property
	def ok(self) -> bool:
		return not self.error


def archive_kind(path: Path) -> str:
	try:
		with path.open('rb') as fh:
			head = fh.read(8)
	except OSError:
		return ''
	return next((kind for magic, kind in ARCHIVE_MAGIC if head.startswith(magic)), '')


def extract_archive(path: Path, kind: str, dest: Path) -> str:
	"""Unpack into dest. Returns an error string, empty on success."""
	dest.mkdir(parents=True, exist_ok=True)
	errors = []
	for template in EXTRACTORS.get(kind, ()):
		argv = [a.format(src=str(path), dest=str(dest)) for a in template]
		if not shutil.which(argv[0]):
			continue
		try:
			proc = subprocess.run(argv, stdin=subprocess.DEVNULL, capture_output=True,
			                      timeout=EXTRACT_TIMEOUT)
		except (OSError, subprocess.SubprocessError) as exc:
			errors.append(f'{argv[0]}: {exc}')
			continue
		# a partial extraction is still worth classifying
		if proc.returncode == 0 or any(dest.iterdir()):
			return ''
		errors.append(f'{argv[0]}: rc={proc.returncode} '
		              f'{proc.stderr.decode("utf-8", "replace").strip()[:120]}')
	return '; '.join(errors) or f'no extractor available for {kind}'


def probe_archive(path: Path, kind: str, scratch: Scratch, serial: int) -> ArchiveFacts:
	facts = ArchiveFacts(path=path, kind=kind)
	try:
		facts.size = path.stat().st_size
	except OSError as exc:
		facts.error = str(exc)
		return facts

	dest = scratch.root / f'{serial:04d}-{path.name}'
	facts.error = extract_archive(path, kind, dest)
	if facts.error:
		return facts
	facts.root = dest
	facts.members = sorted(p for p in dest.rglob('*') if p.is_file())

	if kind != 'cab':
		return facts

	# the binary header and the provisioning document describe the same
	# install; take whichever parses first, but treat both as metadata rather
	# than as payload to be classified
	for member in facts.members:
		if member.suffix.lower() == '.999':
			facts.setup_dll = member.name
		try:
			if member.name.lower() == '_setup.xml':
				facts.metadata.append(member)
				if facts.install is None:
					facts.install = parse_setup_xml(member.read_bytes())
			elif member.suffix.lower() == '.000':
				data = member.read_bytes()
				if data[:4] in MSCE_SIGNATURES:
					facts.metadata.append(member)
					if facts.install is None or facts.install.origin == '_setup.xml':
						facts.install = parse_msce(data)
		except Exception as exc:
			log.warning('cab metadata', path=str(member), error=str(exc))
	return facts


