def _count_magic(data, needle: bytes) -> int:
	"""Occurrence count over a buffer; pefile hands us an mmap, which has
	find() but no count()."""
	total, pos = 0, data.find(needle)
	while pos >= 0:
		total += 1
		pos = data.find(needle, pos + 1)
	return total


def _res_type_name(entry) -> str:
	if entry.name is not None:
		return str(entry.name)
	return pefile.RESOURCE_TYPE.get(entry.struct.Id, f'#{entry.struct.Id}')


def _parse_string_table(data: bytes) -> list[str]:
	"""RT_STRING blocks are 16 counted UTF-16 strings back to back."""
	out, off = [], 0
	for _ in range(16):
		if off + 2 > len(data):
			break
		(count,) = struct.unpack_from('<H', data, off)
		off += 2
		text = data[off:off + count * 2].decode('utf-16le', 'replace')
		off += count * 2
		if text:
			out.append(text)
	return out


def _probe_resources(pe: pefile.PE, facts: Facts) -> None:
	root = getattr(pe, 'DIRECTORY_ENTRY_RESOURCE', None)
	if root is None:
		return
	for type_entry in root.entries:
		name = _res_type_name(type_entry)
		facts.resource_types.append(name)
		for id_entry in getattr(type_entry.directory, 'entries', []):
			for lang_entry in getattr(id_entry.directory, 'entries', []):
				lang = lang_entry.id or 0
				bucket = facts.resource_langs.setdefault(lang, {})
				bucket[name] = bucket.get(name, 0) + 1
				if name != 'RT_STRING':
					continue
				try:
					data = pe.get_data(lang_entry.data.struct.OffsetToData,
					                   lang_entry.data.struct.Size)
				except pefile.PEFormatError:
					continue
				facts.string_tables.setdefault(lang, []).extend(_parse_string_table(data))

	for file_info in getattr(pe, 'FileInfo', []):
		for entry in file_info:
			for table in getattr(entry, 'StringTable', []):
				for key, value in table.entries.items():
					text = value.decode('utf-8', 'replace').strip()
					if text:
						facts.version_info.setdefault(key.decode('utf-8', 'replace'), text)
			for var in getattr(entry, 'Var', []):
				raw = var.entry.get(b'Translation')
				if not raw:
					continue
				parts = str(raw).split()
				if len(parts) == 2:
					facts.translations.append((int(parts[0], 16), int(parts[1], 16)))


def _public_key_token(key: bytes) -> str:
	if not key:
		return ''
	return hashlib.sha1(key).digest()[-8:][::-1].hex().upper()


def _probe_net(path: Path, facts: Facts) -> None:
	import dnfile

	try:
		dn = dnfile.dnPE(str(path), fast_load=True)
		dn.parse_data_directories()
	except Exception as exc:
		log.warning('dnfile failed', path=str(path), error=str(exc))
		return
	if not dn.net:
		return

	net = NetFacts()
	net.metadata_version = bytes(dn.net.metadata.struct.Version).rstrip(b'\0').decode('ascii', 'replace')
	flags = dn.net.Flags
	net.flags = [n for n in dir(flags) if n.startswith('CLR_') and getattr(flags, n)]

	tables = dn.net.mdtables
	if tables.Assembly and tables.Assembly.rows:
		row = tables.Assembly.rows[0]
		net.assembly = str(row.Name.value)
		net.assembly_version = f'{row.MajorVersion}.{row.MinorVersion}.{row.BuildNumber}.{row.RevisionNumber}'
	for row in (tables.AssemblyRef.rows if tables.AssemblyRef else []):
		blob = bytes(row.PublicKey.value or b'') if row.PublicKey else b''
		# afPublicKey means the blob holds the full key, from which the token
		# is the last 8 bytes of its SHA-1, reversed
		token = _public_key_token(blob) if row.Flags.afPublicKey else blob.hex().upper()
		net.refs.append((
			str(row.Name.value),
			f'{row.MajorVersion}.{row.MinorVersion}.{row.BuildNumber}.{row.RevisionNumber}',
			token,
			bool(row.Flags.afRetargetable),
		))

	match = TFM_RE.search(dn.__data__)
	if match:
		net.tfm = match.group().decode('ascii', 'replace')
	facts.net = net


def probe(path: Path) -> Facts:
	"""Extract raw facts from one file. Never raises for bad input."""
	facts = Facts(path=path)
	try:
		facts.size = path.stat().st_size
	except OSError as exc:
		facts.error = str(exc)
		return facts

	try:
		pe = pefile.PE(str(path), fast_load=True)
	except pefile.PEFormatError as exc:
		facts.error = f'not a PE file ({exc})'
		return facts
	except OSError as exc:
		facts.error = str(exc)
		return facts

	with pe:
		pe.parse_data_directories(directories=[
			pefile.DIRECTORY_ENTRY['IMAGE_DIRECTORY_ENTRY_EXPORT'],
			pefile.DIRECTORY_ENTRY['IMAGE_DIRECTORY_ENTRY_IMPORT'],
			pefile.DIRECTORY_ENTRY['IMAGE_DIRECTORY_ENTRY_RESOURCE'],
			pefile.DIRECTORY_ENTRY['IMAGE_DIRECTORY_ENTRY_DEBUG'],
			pefile.DIRECTORY_ENTRY['IMAGE_DIRECTORY_ENTRY_DELAY_IMPORT'],
		])
		opt, hdr = pe.OPTIONAL_HEADER, pe.FILE_HEADER

		facts.machine = hdr.Machine
		facts.is_dll = bool(hdr.Characteristics & pefile.IMAGE_CHARACTERISTICS['IMAGE_FILE_DLL'])
		facts.is_system = bool(hdr.Characteristics & pefile.IMAGE_CHARACTERISTICS['IMAGE_FILE_SYSTEM'])
		facts.timestamp = hdr.TimeDateStamp
		facts.subsystem = opt.Subsystem
		facts.subsys_ver = (opt.MajorSubsystemVersion, opt.MinorSubsystemVersion)
		facts.os_ver = (opt.MajorOperatingSystemVersion, opt.MinorOperatingSystemVersion)
		facts.image_ver = (opt.MajorImageVersion, opt.MinorImageVersion)
		facts.linker = (opt.MajorLinkerVersion, opt.MinorLinkerVersion)
		facts.pe32_plus = opt.Magic == pefile.OPTIONAL_HEADER_MAGIC_PE_PLUS
		facts.entrypoint = opt.AddressOfEntryPoint
		facts.sections = [s.Name.rstrip(b'\0').decode('latin-1') for s in pe.sections]
		facts.signed_bytes = opt.DATA_DIRECTORY[
			pefile.DIRECTORY_ENTRY['IMAGE_DIRECTORY_ENTRY_SECURITY']].Size
		facts.has_clr = bool(opt.DATA_DIRECTORY[
			pefile.DIRECTORY_ENTRY['IMAGE_DIRECTORY_ENTRY_COM_DESCRIPTOR']].VirtualAddress)

		for entry in getattr(pe, 'DIRECTORY_ENTRY_IMPORT', []):
			facts.imports[entry.dll.decode('latin-1').lower()] = len(entry.imports)
		for entry in getattr(pe, 'DIRECTORY_ENTRY_DELAY_IMPORT', []):
			facts.delay_imports[entry.dll.decode('latin-1').lower()] = len(entry.imports)

		exp = getattr(pe, 'DIRECTORY_ENTRY_EXPORT', None)
		if exp is not None:
			if exp.name:
				facts.export_name = exp.name.decode('latin-1')
			facts.exports = [s.name.decode('latin-1') for s in exp.symbols if s.name]

		for dbg in getattr(pe, 'DIRECTORY_ENTRY_DEBUG', []):
			raw = getattr(dbg.entry, 'PdbFileName', None)
			if raw:
				facts.pdb_path = raw.rstrip(b'\0').decode('latin-1', 'replace')
				break

		try:
			start = pe.get_overlay_data_start_offset()
		except Exception:
			start = None
		# the Authenticode blob lives past the last section too; it is not
		# interesting as "appended data"
		facts.overlay = max(0, facts.size - (start or facts.size) - facts.signed_bytes)
		facts.embedded_cabs = _count_magic(pe.__data__, b'MSCF')

		_probe_resources(pe, facts)

	if facts.has_clr:
		_probe_net(path, facts)
	return facts


