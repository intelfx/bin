# lspci's name for the PCIe port type -> (tag, side of the link it sits on):
#   'up'   -- links towards the root (endpoints, switch upstream ports)
#   'down' -- links towards the leaves (root ports, switch downstream ports)
#   ''     -- has no link (integrated endpoints, event collectors)
PORT_TYPES = {
	'Endpoint': ('EP', 'up'),
	'Legacy Endpoint': ('LEP', 'up'),
	'Upstream Port': ('USP', 'up'),
	'PCI-Express to PCI/PCI-X Bridge': ('PCIe-PCI', 'up'),
	'Root Port': ('RP', 'down'),
	'Downstream Port': ('DSP', 'down'),
	'PCI/PCI-X to PCI-Express Bridge': ('PCI-PCIe', 'down'),
	'Root Complex Integrated Endpoint': ('RCiEP', ''),
	'Root Complex Event Collector': ('RCEC', ''),
}

ENDPOINT_KINDS = {'EP', 'LEP'}

ASPM_STATES = ['L0s', 'L1']
L1SS_STATES = ['ASPM L1.1', 'ASPM L1.2', 'PCI-PM L1.1', 'PCI-PM L1.2']

# ASPM state -> sysfs knob under /sys/bus/pci/devices/*/link/
ASPM_KNOBS = {
	'L0s': 'l0s_aspm',
	'L1': 'l1_aspm',
	'ASPM L1.1': 'l1_1_aspm',
	'ASPM L1.2': 'l1_2_aspm',
	'PCI-PM L1.1': 'l1_1_pcipm',
	'PCI-PM L1.2': 'l1_2_pcipm',
	'ClockPM': 'clkpm',
}

GPU_DRIVERS = {
	'amdgpu',
	'radeon',
	'nouveau',
	'nvidia',
	'i915',
	'xe',
}

# downstream ports whose links are tunnelled, and so report a nominal
# speed and width that bear no relation to the actual throughput
TUNNEL_RE = re.compile(r'Thunderbolt|USB4|Type-C|\bJHL\d', re.IGNORECASE)

# correctable errors that do not on their own indicate a link problem
BENIGN_CE = {'AdvNonFatalErr'}
# uncorrectable errors routinely latched by enumeration and config probing
BENIGN_UE = {'UnsupReq'}

INFO, WARN, ERROR = 1, 2, 3
SEVERITY_NAMES = {
	0: '',
	INFO: 'info',
	WARN: 'warn',
	ERROR: 'error',
}
SEVERITY_MARKS = {
	INFO: '',
	WARN: '!',
	ERROR: '!!',
}
SEVERITY_COLOURS = {
	0: 'green',
	INFO: 'green',
	WARN: 'yellow',
	ERROR: 'red',
}

SYSFS_PCI = Path('/sys/bus/pci/devices')
SYSFS_ASPM_POLICY = Path('/sys/module/pcie_aspm/parameters/policy')
UDEV_DATA = Path('/run/udev/data')
BDF_RE = re.compile(r'^[0-9a-f]{4,}:[0-9a-f]{2}:[0-9a-f]{2}\.[0-7]$')


def lane_mbps(speed: float) -> int:
	"""Usable per-lane bandwidth after encoding overhead, rounded the way the
	kernel does it (PCIE_SPEED2MBS_ENC), so that figures match its log."""
	mts = round(speed * 1000)
	if speed >= 64:
		return mts
	if speed >= 8:
		return mts * 128 // 130
	return mts * 8 // 10


def fmt_speed(speed: float | None) -> str:
	return f'{speed:g}GT/s' if speed is not None else '?'


def fmt_link(speed: float | None, width: int | None) -> str:
	if width == 0:
		return 'down'
	return f'{fmt_speed(speed)} x{width if width is not None else "?"}'


def fmt_gbps(mbps: int) -> str:
	return f'{mbps / 1000:.1f}'


def fmt_ns(ns: float) -> str:
	if math.isinf(ns):
		return 'unlimited'
	if ns >= 1000:
		return f'{ns / 1000:g}us'
	return f'{ns:g}ns'


def fmt_size(size: int) -> str:
	for unit in ('B', 'KB', 'MB', 'GB', 'TB'):
		if size < 1024 or unit == 'TB':
			return f'{size:g}{unit}'
		size //= 1024
	assert False


def _min(*values: Any) -> Any:
	present = [v for v in values if v is not None]
	return min(present) if present else None


