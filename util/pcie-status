@dataclass
class LinkFacts:
	"""One port's view of its link (LnkCap, LnkCtl, LnkSta and their "2" twins).

	ASPM sets are None when unknown, as opposed to empty.
	"""
	max_speed: float | None = None
	max_width: int | None = None
	speeds: str = ''
	aspm_cap: frozenset[str] | None = None
	exit_latency: dict[str, float] = field(default_factory=dict)
	clockpm_cap: bool = False
	aspm: frozenset[str] | None = None
	clockpm: bool = False
	commclk: bool = False
	speed: float | None = None
	width: int | None = None
	status: dict[str, bool] = field(default_factory=dict)
	target: float | None = None


@dataclass
class ExpressFacts:
	version: int = 0
	kind: str = ''
	side: str = ''
	hotplug: bool = False
	mps_cap: int | None = None
	mps: int | None = None
	mrrs: int | None = None
	# ASPM state -> exit latency the function tolerates, ns
	acceptable: dict[str, float] = field(default_factory=dict)
	ltr_cap: bool = False
	ltr: bool = False
	link: LinkFacts | None = None
	# reconstructed from sysfs: only link speed, width and ASPM are known
	partial: bool = False


@dataclass
class PmFacts:
	version: int = 0
	d1: bool = False
	d2: bool = False
	pme: list[str] = field(default_factory=list)
	state: str = ''
	no_soft_reset: bool = False


@dataclass
class L1ssFacts:
	cap: frozenset[str] = frozenset()
	ctl: frozenset[str] = frozenset()


@dataclass
class SysFacts:
	parent: str = ''
	power_state: str = ''
	rpm_control: str = ''
	rpm_status: str = ''
	d3cold_allowed: bool | None = None
	# link/* knob -> enabled; a knob is present only for states the kernel
	# considers usable on the link
	knobs: dict[str, bool] = field(default_factory=dict)
	# 'correctable' / 'fatal' / 'nonfatal' -> {error name: count}
	aer: dict[str, dict[str, int]] = field(default_factory=dict)
	speed: float | None = None
	max_speed: float | None = None
	width: int | None = None
	max_width: int | None = None
	is_bridge: bool = False
	udev: dict[str, str] = field(default_factory=dict)


@dataclass
class Facts:
	bdf: str
	cls: str = ''
	name: str = ''
	rev: str = ''
	driver: str = ''
	secondary: int | None = None
	error: str = ''
	denied: bool = False
	express: ExpressFacts | None = None
	pm: PmFacts | None = None
	l1ss: L1ssFacts | None = None
	# (BAR index, current size, largest supported size)
	rebar: list[tuple[int, int, int]] = field(default_factory=list)
	ce_status: list[str] = field(default_factory=list)
	ue_status: list[str] = field(default_factory=list)
	sys: SysFacts | None = None
	klog: list[str] = field(default_factory=list)

	@property
	def domain(self) -> str:
		return self.bdf.split(':')[0]

	@property
	def bus(self) -> int:
		return int(self.bdf.split(':')[1], 16)

	@property
	def short(self) -> str:
		return self.bdf.removeprefix('0000:')

	@property
	def link(self) -> LinkFacts | None:
		return self.express.link if self.express else None

	@property
	def kind(self) -> str:
		return self.express.kind if self.express else ''

	@property
	def side(self) -> str:
		return self.express.side if self.express else ''

	@property
	def is_gpu(self) -> bool:
		return self.driver in GPU_DRIVERS or self.cls.startswith(('VGA', '3D', 'Display'))


HEADER_RE = re.compile(
	r'^(?:(?P<domain>[0-9a-f]{4,}):)?(?P<bus>[0-9a-f]{2}):(?P<dev>[0-9a-f]{2})\.(?P<fn>[0-7])'
	r' (?P<cls>[^:]+): (?P<name>.*)$'
)
CAP_RE = re.compile(r'^Capabilities: \[[0-9a-f]+(?: v\d+)?\] (?P<name>.*)$')
FIELD_RE = re.compile(r'^(?P<key>[A-Za-z][\w .#/-]*?):\s*(?P<value>.*)$')
FLAG_RE = re.compile(r'([^\s,;:()]+?)([+-])(?=[\s,;)]|$)')
SPEED_RE = re.compile(r'(\d+(?:\.\d+)?)GT/s')


def _flags(text: str) -> dict[str, bool]:
	"""lspci's `Name+ Other-` notation."""
	return {m[1]: m[2] == '+' for m in FLAG_RE.finditer(text)}


def _set_flags(text: str) -> list[str]:
	return [k for k, v in _flags(text).items() if v]


def _speed(text: str) -> float | None:
	m = SPEED_RE.search(text)
	return float(m[1]) if m else None


def _int(pattern: str, text: str) -> int | None:
	m = re.search(pattern, text)
	return int(m[1]) if m else None


def _latency(text: str) -> float | None:
	"""An lspci latency bound in ns. Open-ended codes take the values the
	kernel assumes for them: '>4us' and '>64us' as 5us and 65us."""
	if text == 'unlimited':
		return math.inf
	m = re.fullmatch(r'([<>])(\d+)(ns|us)', text)
	if not m:
		return None
	unit = 1000 if m[3] == 'us' else 1
	return int(m[2]) * unit + (unit if m[1] == '>' else 0)


def _size(text: str) -> int | None:
	m = re.fullmatch(r'(\d+)([KMGT]?)B', text)
	if not m:
		return None
	return int(m[1]) << (10 * ' KMGT'.index(m[2] or ' '))


def _parse_link(f: dict[str, str]) -> LinkFacts:
	cap, ctl, sta = f.get('LnkCap', ''), f.get('LnkCtl', ''), f.get('LnkSta', '')
	link = LinkFacts(
		max_speed=_speed(cap),
		max_width=_int(r'Width x(\d+)', cap),
		speed=_speed(sta),
		width=_int(r'Width x(\d+)', sta),
		status=_flags(sta),
	)

	# the Supported Link Speeds vector, where present, is authoritative
	m = re.search(r'Supported Link Speeds: ([^,]+)', f.get('LnkCap2', ''))
	if m and _speed(m[1]):
		link.speeds = m[1]
		link.max_speed = _speed(m[1])
	m = re.search(r'Target Link Speed: (\S+)', f.get('LnkCtl2', ''))
	if m:
		link.target = _speed(m[1])

	m = re.search(r'ASPM (not supported|unknown|L0s L1|L0s|L1)\b', cap)
	if m:
		link.aspm_cap = frozenset(s for s in m[1].split() if s in ASPM_STATES)
	for state in ASPM_STATES:
		m = re.search(rf'Exit Latency\b.*?\b{state} ([<>]\d+[nu]s)', cap)
		lat = _latency(m[1]) if m else None
		if lat is not None:
			link.exit_latency[state] = lat
	link.clockpm_cap = _flags(cap).get('ClockPM', False)

	m = re.search(r'ASPM (Disabled|L0s L1 Enabled|L0s Enabled|L1 Enabled)', ctl)
	if m:
		link.aspm = frozenset(s for s in m[1].split() if s in ASPM_STATES)
	ctl_flags = _flags(ctl)
	link.clockpm = ctl_flags.get('ClockPM', False)
	link.commclk = ctl_flags.get('CommClk', False)
	return link


def _parse_express(dev: Facts, name: str, f: dict[str, str]) -> None:
	m = re.match(r'Express \(v(\d+)\) (.+?)(?: \(Slot[+-]\))?,', name)
	if not m:
		log.warning('unrecognised Express capability', bdf=dev.bdf, header=name)
		return
	kind, side = PORT_TYPES.get(m[2], (m[2], ''))
	devcap, devctl = f.get('DevCap', ''), f.get('DevCtl', '')
	e = ExpressFacts(
		version=int(m[1]),
		kind=kind,
		side=side,
		hotplug=_flags(f.get('SltCap', '')).get('HotPlug', False),
		mps_cap=_int(r'MaxPayload (\d+) bytes', devcap),
		mps=_int(r'MaxPayload (\d+) bytes', devctl),
		mrrs=_int(r'MaxReadReq (\d+) bytes', devctl),
		ltr_cap=_flags(f.get('DevCap2', '')).get('LTR', False),
		ltr=_flags(f.get('DevCtl2', '')).get('LTR', False),
	)
	m = re.search(r'Latency L0s ([^,\s]+), L1 ([^,\s]+)', devcap)
	if m:
		for state, text in zip(ASPM_STATES, (m[1], m[2])):
			lat = _latency(text)
			if lat is not None:
				e.acceptable[state] = lat
	if 'LnkCap' in f:
		e.link = _parse_link(f)
	dev.express = e


def _parse_pm(dev: Facts, name: str, f: dict[str, str]) -> None:
	flags = f.get('Flags', '')
	status = f.get('Status', '').split()
	m = re.search(r'PME\(([^)]*)\)', flags)
	state = status[0] if status else ''
	dev.pm = PmFacts(
		version=_int(r'version (\d+)', name) or 0,
		d1=_flags(flags).get('D1', False),
		d2=_flags(flags).get('D2', False),
		pme=[s[:-1] for s in m[1].split(',') if s.endswith('+')] if m else [],
		state='D3hot' if state == 'D3' else state,
		no_soft_reset=_flags(f.get('Status', '')).get('NoSoftRst', False),
	)


def _parse_l1ss(dev: Facts, name: str, f: dict[str, str]) -> None:
	def states(text: str) -> frozenset[str]:
		return frozenset(
			k.replace('_', ' ')
			for k in _set_flags(text)
			if k.replace('_', ' ') in L1SS_STATES
		)

	dev.l1ss = L1ssFacts(
		cap=states(f.get('L1SubCap', '')),
		ctl=states(f.get('L1SubCtl1', '')),
	)


def _parse_aer(dev: Facts, name: str, f: dict[str, str]) -> None:
	dev.ce_status = _set_flags(f.get('CESta', ''))
	dev.ue_status = _set_flags(f.get('UESta', ''))


def _parse_rebar(dev: Facts, name: str, f: dict[str, str]) -> None:
	for key, value in f.items():
		m = re.fullmatch(r'BAR (\d+)', key)
		sizes = re.search(r'current size: (\S+?), supported: (.*)', value)
		if not m or not sizes:
			continue
		current = _size(sizes[1])
		supported = [s for s in map(_size, sizes[2].split()) if s]
		if current and supported:
			dev.rebar.append((int(m[1]), current, max(supported)))


CAP_PARSERS = [
	('Express', _parse_express),
	('Power Management', _parse_pm),
	('L1 PM Substates', _parse_l1ss),
	('Advanced Error Reporting', _parse_aer),
	('Physical Resizable BAR', _parse_rebar),
	('Resizable BAR', _parse_rebar),
]


def _parse_device_line(dev: Facts, line: str) -> None:
	if line.startswith('Bus: '):
		m = re.search(r'secondary=([0-9a-f]+)', line)
		if m:
			dev.secondary = int(m[1], 16)
	elif line.startswith('Kernel driver in use: '):
		dev.driver = line.split(': ', 1)[1]
	elif line == 'Capabilities: <access denied>':
		dev.denied = True
	elif line.startswith('!!!'):
		dev.error = line.lstrip('! ')


def parse_lspci(text: str) -> list[Facts]:
	"""Split `lspci -vvv` output into per-function facts.

	Device-level lines are indented by one tab, capability fields by two,
	and anything deeper continues the field above it.
	"""
	out: list[Facts] = []
	dev: Facts | None = None
	cap: tuple[str, dict[str, str]] | None = None
	key = ''

	def finish() -> None:
		nonlocal cap
		if dev is not None and cap is not None:
			name, fields = cap
			for prefix, parser in CAP_PARSERS:
				if name.startswith(prefix):
					parser(dev, name, fields)
					break
		cap = None

	for raw in text.splitlines():
		if not raw.strip():
			continue
		m = HEADER_RE.match(raw)
		if m:
			finish()
			name = re.sub(r' \(prog-if [^)]*\)$', '', m['name'])
			rev = re.search(r' \(rev ([0-9a-f]+)\)$', name)
			dev = Facts(
				bdf=f'{m["domain"] or "0000"}:{m["bus"]}:{m["dev"]}.{m["fn"]}',
				cls=m['cls'],
				name=name[: rev.start()] if rev else name,
				rev=rev[1] if rev else '',
			)
			out.append(dev)
			continue
		if dev is None:
			continue

		depth = len(raw) - len(raw.lstrip('\t'))
		line = raw.strip()
		if depth <= 1:
			finish()
			m = CAP_RE.match(line)
			if m:
				cap = (m['name'], {})
				key = ''
			else:
				_parse_device_line(dev, line)
		elif cap is not None:
			m = FIELD_RE.match(line) if depth == 2 else None
			if m:
				key = m['key']
				cap[1].setdefault(key, m['value'])
			elif key:
				cap[1][key] += ' ' + line
	finish()
	return out


def _read(path: Path) -> str:
	try:
		return path.read_text().strip()
	except OSError:
		return ''


def _sys_speed(text: str) -> float | None:
	m = re.match(r'(\d+(?:\.\d+)?) GT/s', text)
	return float(m[1]) if m else None


def _sys_int(text: str) -> int | None:
	return int(text) if text.isdigit() else None


def probe_sysfs(bdf: str) -> SysFacts:
	d = SYSFS_PCI / bdf
	s = SysFacts(
		power_state=_read(d / 'power_state'),
		rpm_control=_read(d / 'power' / 'control'),
		rpm_status=_read(d / 'power' / 'runtime_status'),
		speed=_sys_speed(_read(d / 'current_link_speed')),
		max_speed=_sys_speed(_read(d / 'max_link_speed')),
		width=_sys_int(_read(d / 'current_link_width')),
		max_width=_sys_int(_read(d / 'max_link_width')),
		is_bridge=_read(d / 'class').startswith('0x0604'),
	)
	parent = d.resolve().parent.name
	if BDF_RE.match(parent):
		s.parent = parent
	d3cold = _read(d / 'd3cold_allowed')
	if d3cold:
		s.d3cold_allowed = d3cold == '1'

	try:
		knobs = sorted((d / 'link').iterdir())
	except OSError:
		knobs = []
	for knob in knobs:
		s.knobs[knob.name] = _read(knob) == '1'

	for kind in ('correctable', 'fatal', 'nonfatal'):
		counters = {}
		for line in _read(d / f'aer_dev_{kind}').splitlines():
			name, _, count = line.rpartition(' ')
			if count.isdigit():
				counters[name] = int(count)
		if counters:
			s.aer[kind] = counters

	for line in _read(UDEV_DATA / f'+pci:{bdf}').splitlines():
		k, _, v = line.removeprefix('E:').partition('=')
		if line.startswith('E:') and v:
			s.udev[k] = v
	return s


def _would_wake(bdf: str, sysfacts: dict[str, SysFacts]) -> bool:
	"""Reading config space through sysfs resumes the parent bridge, and the
	device itself if it is in D3cold (see pci_config_pm_runtime_get())."""
	s = sysfacts[bdf]
	parent = sysfacts.get(s.parent)
	return s.power_state == 'D3cold' or (parent is not None and parent.rpm_status == 'suspended')


def run_lspci(*args: str) -> str:
	argv = ['lspci', '-D', '-vvv', *args]
	try:
		proc = subprocess.run(argv, check=True, capture_output=True, text=True)
	except (OSError, subprocess.CalledProcessError) as exc:
		raise typer.BadParameter(f'{shlex.join(argv)}: {exc}') from exc
	return proc.stdout


KLOG_RE = re.compile(r'^\S+ (?P<bdf>[0-9a-f]{4,}:[0-9a-f]{2}:[0-9a-f]{2}\.[0-7]): (?P<msg>.*)$')
KLOG_INTERESTING = re.compile(
	r'ASPM|PCIe Bus Error|AER: (?:Corrected|Uncorrected|Multiple)|bandwidth|'
	r'Link (?:Up|Down)|retrain|downtrain|L1 ?SS|L1\.2|LTR|power state|D3cold|bwctrl'
)
KLOG_BORING = re.compile(r'PME# supported')
KLOG_BANDWIDTH = re.compile(r'available PCIe bandwidth')
KLOG_AER = re.compile(r'PCIe Bus Error')
KLOG_POWER = re.compile(r'Unable to change power state|Refused to change power state')


def probe_klog() -> dict[str, list[str]]:
	"""Kernel messages of the current boot that speak about link or power
	management of a particular device, keyed by device."""
	argv = ['journalctl', '--dmesg', '--boot', '--output=cat', '--no-pager', '--quiet']
	try:
		proc = subprocess.run(argv, check=True, capture_output=True, text=True)
	except (OSError, subprocess.CalledProcessError) as exc:
		log.warning('cannot read the kernel log', error=str(exc))
		return {}
	out: dict[str, list[str]] = {}
	for line in proc.stdout.splitlines():
		m = KLOG_RE.match(line)
		if m and KLOG_INTERESTING.search(m['msg']) and not KLOG_BORING.search(m['msg']):
			out.setdefault(m['bdf'], []).append(m['msg'])
	return out


@dataclass
class Context:
	live: bool = False
	# pcie_aspm.policy, and pcie_aspm= on the kernel command line
	policy: str = ''
	cmdline: str = ''


def probe_context() -> Context:
	ctx = Context(live=True)
	m = re.search(r'\[(\w+)\]', _read(SYSFS_ASPM_POLICY))
	if m:
		ctx.policy = m[1]
	m = re.search(r'(?:^|\s)pcie_aspm=(\S+)', _read(Path('/proc/cmdline')))
	if m:
		ctx.cmdline = m[1]
	return ctx


def _from_sysfs(bdf: str, s: SysFacts) -> Facts:
	"""Facts about a device lspci was not run on, as far as sysfs knows them."""
	return Facts(
		bdf=bdf,
		cls=s.udev.get('ID_PCI_SUBCLASS_FROM_DATABASE', s.udev.get('ID_PCI_CLASS_FROM_DATABASE', '')),
		name=' '.join(
			x
			for x in (
				s.udev.get('ID_VENDOR_FROM_DATABASE', ''),
				s.udev.get('ID_MODEL_FROM_DATABASE', ''),
			)
			if x
		),
		error='config space not read: doing so would wake the device',
	)


def probe_live(no_wake: bool) -> list[Facts]:
	# capture power state before lspci perturbs it
	sysfacts = {bdf: probe_sysfs(bdf) for bdf in sorted(os.listdir(SYSFS_PCI))}

	if no_wake:
		facts = []
		for bdf, s in sysfacts.items():
			if _would_wake(bdf, sysfacts):
				facts.append(_from_sysfs(bdf, s))
			else:
				facts.extend(parse_lspci(run_lspci('-s', bdf)))
	else:
		facts = parse_lspci(run_lspci())

	klog = probe_klog()
	for f in facts:
		f.sys = sysfacts.get(f.bdf)
		f.klog = klog.get(f.bdf, [])
		if f.sys and not f.driver:
			driver = SYSFS_PCI / f.bdf / 'driver'
			if driver.exists():
				f.driver = driver.resolve().name

	denied = sum(f.denied for f in facts)
	if denied:
		log.warning(
			f'lspci could not read capabilities of {denied} device(s); '
			f'run as root for complete data'
		)
	return facts


def _fill_from_sysfs(f: Facts, parent: Facts | None) -> None:
	"""Stand in for an unreadable PCIe capability with what sysfs exposes
	without privileges: link speed and width, and the kernel's ASPM knobs.

	The knobs describe the link as a whole, so they are attributed to both of
	its ends, unless the port's own capability could be read.
	"""
	s = f.sys
	if f.express is not None or s is None or not s.max_width:
		return
	if s.is_bridge and parent is not None and parent.side == 'down':
		kind, side = 'USP', 'up'
	elif s.is_bridge:
		kind, side = ('DSP' if parent is not None else 'RP'), 'down'
	elif parent is not None:
		kind, side = 'EP', 'up'
	else:
		return
	link = LinkFacts(
		max_speed=s.max_speed,
		max_width=s.max_width,
		speed=s.speed,
		width=s.width,
	)
	f.express = ExpressFacts(kind=kind, side=side, link=link, partial=True)
	if side != 'up' or not s.knobs:
		return

	link.aspm_cap = frozenset(k for k in ASPM_STATES if ASPM_KNOBS[k] in s.knobs)
	link.aspm = frozenset(k for k in ASPM_STATES if s.knobs.get(ASPM_KNOBS[k]))
	f.l1ss = L1ssFacts(
		cap=frozenset(k for k in L1SS_STATES if ASPM_KNOBS[k] in s.knobs),
		ctl=frozenset(k for k in L1SS_STATES if s.knobs.get(ASPM_KNOBS[k])),
	)
	if parent is not None and parent.express is not None and parent.express.partial:
		assert parent.link is not None
		parent.link.aspm_cap = link.aspm_cap
		parent.link.aspm = link.aspm
		parent.l1ss = f.l1ss


