# layer 2: analysis
# --------------------------------------------------------------------------

@dataclass
class Finding:
	severity: int
	text: str


@dataclass
class Pair:
	"""A link: the port facing away from the root, and the first function of
	the component below it."""
	up: Facts
	down: Facts
	# set by the link check when the link trained below its capability for
	# no benign reason
	degraded: bool = False
	# (endpoint, path exit latency, acceptable latency) for every endpoint
	# whose L1 latency budget this link breaks
	l1_blockers: list[tuple[Facts, float, float]] = field(default_factory=list)

	@property
	def ul(self) -> LinkFacts:
		assert self.up.link is not None
		return self.up.link

	@property
	def dl(self) -> LinkFacts:
		assert self.down.link is not None
		return self.down.link

	@property
	def speed(self) -> float | None:
		return self.dl.speed if self.dl.speed is not None else self.ul.speed

	@property
	def width(self) -> int | None:
		return self.dl.width if self.dl.width is not None else self.ul.width

	@property
	def max_speed(self) -> float | None:
		return _min(self.ul.max_speed, self.dl.max_speed)

	@property
	def max_width(self) -> int | None:
		return _min(self.ul.max_width, self.dl.max_width)

	@property
	def tunnelled(self) -> bool:
		e = self.up.express
		return bool(e and e.hotplug and TUNNEL_RE.search(self.up.name))

	def aspm_states(self) -> tuple[list[str], list[str]]:
		"""(enabled, supported) link power states, by the stricter end."""
		sup = _both(self.ul.aspm_cap, self.dl.aspm_cap)
		en = _both(self.ul.aspm, self.dl.aspm) & sup
		supported = [s for s in ASPM_STATES if s in sup]
		enabled = [s for s in ASPM_STATES if s in en]
		if self.up.l1ss and self.down.l1ss and 'L1' in sup:
			ss_sup = self.up.l1ss.cap & self.down.l1ss.cap
			ss_en = self.up.l1ss.ctl & self.down.l1ss.ctl & ss_sup
			supported += [s.removeprefix('ASPM ') for s in L1SS_STATES[:2] if s in ss_sup]
			if 'L1' in en:
				enabled += [s.removeprefix('ASPM ') for s in L1SS_STATES[:2] if s in ss_en]
		return enabled, supported


def _both(a: frozenset[str] | None, b: frozenset[str] | None) -> frozenset[str]:
	"""Intersection of two sets, either of which may be unknown."""
	if a is None:
		return b or frozenset()
	if b is None:
		return a
	return a & b


@dataclass
class Bandwidth:
	available: int
	capable: int
	limiter: Facts
	speed: float
	width: int
	degraded: bool


@dataclass
class Verdict:
	depth: int = 0
	parent: Facts | None = None
	# the link towards the root, for every function of the component below it
	uplink: Pair | None = None
	# the link towards the leaves, for ports with something behind them
	downlink: Pair | None = None
	# whether this is the function that carries findings about the uplink
	owner: bool = False
	bw: Bandwidth | None = None
	dstate: str = ''
	findings: list[Finding] = field(default_factory=list)

	@property
	def severity(self) -> int:
		return max((f.severity for f in self.findings), default=0)

	def add(self, severity: int, text: str) -> None:
		self.findings.append(Finding(severity, text))


@dataclass
class Item:
	facts: Facts
	verdict: Verdict


def _speed_cause(pair: Pair, v: Verdict) -> tuple[int, str]:
	ul, dl = pair.ul, pair.dl
	cap = pair.max_speed
	assert cap is not None and pair.speed is not None
	if ul.target is not None and ul.target < cap and pair.speed <= ul.target:
		return WARN, f'Target Link Speed on {pair.up.short} is {fmt_speed(ul.target)}'
	if ul.status.get('BWMgmt'):
		return WARN, 'retrained to cope with an unreliable link (BWMgmt+)'
	if ul.status.get('ABWMgmt') or dl.status.get('ABWMgmt'):
		return INFO, 'changed autonomously by the device (ABWMgmt+)'
	if pair.down.is_gpu:
		return INFO, 'likely GPU dynamic link power management'
	if v.dstate not in ('', 'D0'):
		return INFO, f'device in {v.dstate}'
	return WARN, 'cause unknown (signal integrity? check slot, riser, cable, firmware)'


def _check_link(pair: Pair, v: Verdict) -> None:
	ul, dl = pair.ul, pair.dl
	up = f'{pair.up.kind} {pair.up.short}'
	if pair.width == 0:
		v.add(WARN, 'link down')
		pair.degraded = True
		return
	if ul.status.get('Train') or dl.status.get('Train'):
		v.add(INFO, 'link training in progress')

	if pair.tunnelled:
		v.add(INFO, f'tunnelled link (via {pair.up.short}): reported speed and width are nominal')
		return

	if ul.max_speed is not None and dl.max_speed is not None and ul.max_speed < dl.max_speed:
		v.add(
			INFO,
			f'speed capped by {up} ({fmt_speed(ul.max_speed)} < {fmt_speed(dl.max_speed)})',
		)
	if ul.max_width is not None and dl.max_width is not None and ul.max_width < dl.max_width:
		v.add(INFO, f'width capped by {up} (x{ul.max_width} < x{dl.max_width})')

	if pair.speed is not None and pair.max_speed is not None and pair.speed < pair.max_speed:
		severity, cause = _speed_cause(pair, v)
		v.add(severity, f'speed {fmt_speed(pair.speed)} < {fmt_speed(pair.max_speed)}: {cause}')
		pair.degraded |= severity >= WARN
	if pair.width is not None and pair.max_width is not None and pair.width < pair.max_width:
		if ul.status.get('ABWMgmt') or dl.status.get('ABWMgmt'):
			severity, cause = INFO, 'changed autonomously by the device (ABWMgmt+)'
		else:
			severity, cause = WARN, 'lanes failed to train (slot wiring, bifurcation, riser?)'
		v.add(severity, f'width x{pair.width} < x{pair.max_width}: {cause}')
		pair.degraded |= severity >= WARN


def _knob_reason(state: str, pair: Pair, ctx: Context) -> str:
	"""Best guess at why a link power state supported by both ends is off."""
	if ctx.cmdline == 'off':
		return 'pcie_aspm=off'
	s = pair.down.sys
	if s is None:
		return ''
	if not s.knobs:
		return 'ASPM not under OS control'
	if ASPM_KNOBS[state] not in s.knobs:
		return 'not offered by the kernel'
	if ctx.policy == 'performance':
		return 'pcie_aspm.policy=performance'
	if ctx.policy == 'default':
		return 'firmware setting kept by pcie_aspm.policy=default'
	if state.endswith('L1.2') or state.endswith('L1.1'):
		if ctx.policy != 'powersupersave':
			return f'needs pcie_aspm.policy=powersupersave (is {ctx.policy})'
	return 'disabled by driver or via sysfs'


def _with_reason(text: str, reason: str) -> str:
	return f'{text} ({reason})' if reason else text


def _check_aspm(pair: Pair, v: Verdict, ctx: Context) -> None:
	ul, dl = pair.ul, pair.dl
	sup = _both(ul.aspm_cap, dl.aspm_cap)
	l1_on = False
	for state in ASPM_STATES:
		if state not in sup or ul.aspm is None or dl.aspm is None:
			continue
		on_up, on_down = state in ul.aspm, state in dl.aspm
		if on_up and on_down:
			l1_on |= state == 'L1'
		elif on_up or on_down:
			# L0s is controlled per direction and may legitimately be
			# enabled in one only; L1 needs both ends
			where = pair.up.short if on_up else pair.down.short
			severity = WARN if state == 'L1' else INFO
			v.add(severity, f'ASPM {state} enabled on {where} only')
		elif state == 'L1' and pair.l1_blockers:
			ep, lat, acc = pair.l1_blockers[0]
			v.add(
				WARN,
				f'ASPM L1 disabled: exit latency {fmt_ns(lat)} '
				f'exceeds {fmt_ns(acc)} acceptable to {ep.short}',
			)
		else:
			severity = WARN if state == 'L1' else INFO
			v.add(severity, _with_reason(
				f'ASPM {state} supported but disabled',
				_knob_reason(state, pair, ctx),
			))

	up_ss, down_ss = pair.up.l1ss, pair.down.l1ss
	if l1_on and up_ss and down_ss:
		ss_sup = up_ss.cap & down_ss.cap
		for state in L1SS_STATES:
			if state not in ss_sup:
				continue
			on_up, on_down = state in up_ss.ctl, state in down_ss.ctl
			if on_up and on_down:
				continue
			if on_up or on_down:
				where = pair.up.short if on_up else pair.down.short
				v.add(WARN, f'{state} enabled on {where} only')
			else:
				severity = WARN if state.startswith('ASPM') else INFO
				v.add(severity, _with_reason(
					f'{state} supported but disabled',
					_knob_reason(state, pair, ctx),
				))

		if any(s.endswith('L1.2') for s in ss_sup):
			for side in (pair.up, pair.down):
				e = side.express
				assert e is not None
				if e.ltr_cap and not e.ltr:
					v.add(WARN, f'LTR supported but disabled on {side.short} (L1.2 needs it)')
				elif not e.ltr_cap and not e.partial:
					v.add(INFO, f'{side.short} lacks LTR, so L1.2 is unusable')

	if dl.clockpm_cap and not dl.clockpm:
		v.add(INFO, _with_reason(
			'Clock PM supported but disabled',
			_knob_reason('ClockPM', pair, ctx) if l1_on else '',
		))
	if ul.status.get('SlotClk') and dl.status.get('SlotClk') and not (ul.commclk and dl.commclk):
		v.add(INFO, 'common reference clock available but not in use (CommClk-)')


def _check_mps(f: Facts, v: Verdict, path: list[Facts]) -> None:
	e = f.express
	if e is None or e.mps is None:
		return
	if v.uplink and v.uplink.up.express and v.uplink.up.express.mps is not None:
		port = v.uplink.up.express.mps
		if e.mps > port:
			v.add(ERROR, f'MPS {e.mps} exceeds {port} of {v.uplink.up.short}')
	if e.kind in ENDPOINT_KINDS:
		caps = [x.express.mps_cap for x in path if x.express and x.express.mps_cap]
		if caps and e.mps < min(caps):
			v.add(INFO, f'MPS {e.mps} < {min(caps)} supported along the path')


def _check_pm(f: Facts, v: Verdict) -> None:
	s = f.sys
	if s is not None:
		if s.rpm_control == 'on':
			v.add(WARN, 'runtime PM disabled (power/control=on)')
		if s.d3cold_allowed is False and f.kind in ENDPOINT_KINDS:
			v.add(INFO, 'D3cold disallowed')
	if not f.driver and 'bridge' not in f.cls.lower() and not f.error:
		v.add(INFO, 'no driver bound')


def _check_errors(f: Facts, v: Verdict) -> None:
	aer = f.sys.aer if f.sys else {}
	counted = False
	for kind, severity in (('fatal', ERROR), ('nonfatal', ERROR), ('correctable', WARN)):
		counters = aer.get(kind, {})
		total = next((n for k, n in counters.items() if k.startswith('TOTAL_')), 0)
		if not total:
			continue
		counted = True
		top = sorted(
			((n, k) for k, n in counters.items() if n and not k.startswith('TOTAL_')),
			reverse=True,
		)
		v.add(severity, (
			f'{total} {kind} AER error(s) this boot'
			f' ({", ".join(f"{k} {n}" for n, k in top[:3])})'
		))

	if f.ue_status:
		severity = INFO if set(f.ue_status) <= BENIGN_UE else ERROR
		v.add(severity, f'uncorrectable error status latched: {" ".join(f.ue_status)}')
	if f.ce_status and not counted:
		severity = INFO if set(f.ce_status) <= BENIGN_CE else WARN
		v.add(severity, f'correctable error status latched: {" ".join(f.ce_status)}')

	reports = sum(1 for msg in f.klog if KLOG_AER.search(msg))
	if reports and not counted:
		v.add(WARN, f'{reports} AER error report(s) in the kernel log')
	if any(KLOG_POWER.search(msg) for msg in f.klog):
		v.add(WARN, 'failed power state transition(s) in the kernel log')


def _check_rebar(f: Facts, v: Verdict) -> None:
	for bar, current, largest in f.rebar:
		if current < largest:
			v.add(
				WARN if f.is_gpu else INFO,
				f'BAR {bar} is {fmt_size(current)}, resizable to {fmt_size(largest)}',
			)


def _bandwidth(f: Facts, path: list[Facts], pairs: dict[str, Pair]) -> Bandwidth | None:
	"""End-to-end bandwidth the way pcie_bandwidth_available() computes it:
	the slowest link on the path, reporting the one closest to the root."""
	link = f.link
	if link is None or link.max_speed is None or not link.max_width:
		return None
	best: Bandwidth | None = None
	for node in path:
		nl = node.link
		if nl is None or nl.speed is None or not nl.width:
			continue
		mbps = lane_mbps(nl.speed) * nl.width
		if best is None or mbps <= best.available:
			pair = pairs.get(node.bdf)
			best = Bandwidth(
				available=mbps,
				capable=lane_mbps(link.max_speed) * link.max_width,
				limiter=node,
				speed=nl.speed,
				width=nl.width,
				degraded=bool(pair and pair.degraded),
			)
	return best


def _check_bandwidth(f: Facts, v: Verdict) -> None:
	bw = v.bw
	boot = next((m for m in reversed(f.klog) if KLOG_BANDWIDTH.search(m)), '')
	if bw and bw.available < bw.capable:
		v.add(WARN if bw.degraded else INFO, (
			f'{fmt_gbps(bw.available)} of {fmt_gbps(bw.capable)} Gb/s available, '
			f'limited by {fmt_link(bw.speed, bw.width)} at {bw.limiter.short}'
		))
	elif boot:
		m = re.search(r'limited by (.*?) link at (\S+)', boot)
		what = f'{m[1]} at {m[2].removeprefix("0000:")}' if m else boot
		v.add(INFO, f'bandwidth was limited by {what} at enumeration')


def _topology(facts: list[Facts]) -> dict[str, Facts | None]:
	by_bdf = {f.bdf: f for f in facts}
	bridges = {(f.domain, f.secondary): f for f in facts if f.secondary is not None}
	parents: dict[str, Facts | None] = {}
	for f in facts:
		if f.sys is not None and f.sys.parent:
			parents[f.bdf] = by_bdf.get(f.sys.parent)
		else:
			parent = bridges.get((f.domain, f.bus))
			parents[f.bdf] = parent if parent is not f else None
	return parents


def analyse(facts: list[Facts], ctx: Context) -> list[Item]:
	parents = _topology(facts)
	children: dict[str | None, list[Facts]] = {}
	for f in facts:
		parent = parents[f.bdf]
		children.setdefault(parent.bdf if parent else None, []).append(f)

	ordered: list[tuple[Facts, int]] = []

	def walk(key: str | None, depth: int) -> None:
		for f in sorted(children.get(key, []), key=lambda x: x.bdf):
			ordered.append((f, depth))
			walk(f.bdf, depth + 1)

	walk(None, 0)

	def path_of(f: Facts) -> list[Facts]:
		out: list[Facts] = []
		node: Facts | None = f
		while node is not None:
			out.append(node)
			node = parents[node.bdf]
		return out

	verdicts: dict[str, Verdict] = {}
	# by the bdf of either end of the link
	pairs: dict[str, Pair] = {}
	for f, depth in ordered:
		parent = parents[f.bdf]
		_fill_from_sysfs(f, parent)
		v = verdicts[f.bdf] = Verdict(depth=depth, parent=parent)
		v.dstate = (f.sys.power_state if f.sys else '') or (f.pm.state if f.pm else '')
		if (
			parent is None
			or f.side != 'up'
			or parent.side != 'down'
			or f.link is None
			or parent.link is None
		):
			continue
		pair = pairs.get(parent.bdf)
		if pair is None:
			pair = pairs[parent.bdf] = Pair(up=parent, down=f)
			verdicts[parent.bdf].downlink = pair
			v.owner = True
		pairs[f.bdf] = pair
		v.uplink = pair

	# every endpoint function holds every link above it to its own latency budget
	for f, _ in ordered:
		acceptable = f.express.acceptable.get('L1') if f.express else None
		if f.kind not in ENDPOINT_KINDS or acceptable is None:
			continue
		worst, switches = 0.0, 0.0
		for node in path_of(f):
			# a port's entry is the link below it, already seen from the child
			pair = pairs.get(node.bdf)
			if pair is None or node.side != 'up':
				continue
			exits = [x for x in (pair.ul.exit_latency.get('L1'), pair.dl.exit_latency.get('L1')) if x]
			worst = max([worst, *exits])
			if worst + switches > acceptable:
				pair.l1_blockers.append((f, worst + switches, acceptable))
			switches += 1000

	items = []
	for f, _ in ordered:
		v = verdicts[f.bdf]
		path = path_of(f)
		if f.error:
			v.add(INFO, f.error)
		if v.owner and v.uplink:
			_check_link(v.uplink, v)
			_check_aspm(v.uplink, v, ctx)
		_check_mps(f, v, path)
		_check_pm(f, v)
		_check_errors(f, v)
		_check_rebar(f, v)
		items.append(Item(facts=f, verdict=v))

	# bandwidth depends on every link on the path having been checked
	for item in items:
		f, v = item.facts, item.verdict
		if v.owner:
			v.bw = _bandwidth(f, path_of(f), pairs)
			_check_bandwidth(f, v)
		v.findings.sort(key=lambda x: -x.severity)
	return items


