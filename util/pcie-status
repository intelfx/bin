def _clean_name(name: str) -> str:
	return re.sub(r',? (?:Corporation|Corp\.|Inc\.|Co\., Ltd\.|Technology Co\., Ltd\.)', '', name)


def _pair_of(v: Verdict) -> Pair | None:
	return v.uplink or v.downlink


ALL_FIELDS = [
	'bdf',
	'domain',
	'type',
	'class',
	'name',
	'rev',
	'driver',
	'parent',
	'depth',
	'speed',
	'width',
	'maxspeed',
	'maxwidth',
	'target',
	'linkspeed',
	'linkwidth',
	'bw',
	'bwcap',
	'limiter',
	'aspm',
	'aspmcap',
	'clockpm',
	'commclk',
	'ltr',
	'mps',
	'mpscap',
	'mrrs',
	'dstate',
	'rpm',
	'rpmstatus',
	'd3cold',
	'severity',
	'findings',
]

FIELD_HELP = ' '.join(ALL_FIELDS)


def _yn(value: bool) -> str:
	return 'yes' if value else 'no'


def fields(item: Item) -> dict[str, str | None]:
	"""Flat namespace for --format and --verbose. Empty string means
	'not determined', None means 'not applicable'."""
	f, v = item.facts, item.verdict
	e, link, pair, s = f.express, f.link, _pair_of(v), f.sys
	out: dict[str, str | None] = dict.fromkeys(ALL_FIELDS, None)
	out.update({
		'bdf': f.bdf,
		'domain': f.domain,
		'type': f.kind or 'PCI',
		'class': f.cls,
		'name': f.name,
		'rev': f.rev,
		'driver': f.driver,
		'parent': v.parent.bdf if v.parent else None,
		'depth': str(v.depth),
		'dstate': v.dstate,
		'severity': SEVERITY_NAMES[v.severity],
		'findings': '; '.join(x.text for x in v.findings),
	})
	if s is not None:
		out.update({
			'rpm': s.rpm_control,
			'rpmstatus': s.rpm_status,
			'd3cold': _yn(s.d3cold_allowed) if s.d3cold_allowed is not None else '',
		})
	if link is not None:
		out.update({
			'speed': fmt_speed(link.speed) if link.speed is not None else '',
			'width': f'x{link.width}' if link.width is not None else '',
			'maxspeed': fmt_speed(link.max_speed) if link.max_speed is not None else '',
			'maxwidth': f'x{link.max_width}' if link.max_width is not None else '',
			'target': fmt_speed(link.target) if link.target is not None else '',
		})
	if link is not None and e is not None and not e.partial:
		out.update({
			'clockpm': _yn(link.clockpm) if link.clockpm_cap else None,
			'commclk': _yn(link.commclk),
		})
	if pair is not None:
		enabled, supported = pair.aspm_states()
		out.update({
			'linkspeed': fmt_speed(pair.max_speed) if pair.max_speed is not None else '',
			'linkwidth': f'x{pair.max_width}' if pair.max_width is not None else '',
			'aspm': ' '.join(enabled) or ('off' if supported else 'n/a'),
			'aspmcap': ' '.join(supported) or 'n/a',
		})
	if v.bw is not None:
		out.update({
			'bw': fmt_gbps(v.bw.available),
			'bwcap': fmt_gbps(v.bw.capable),
			'limiter': v.bw.limiter.bdf,
		})
	if e is not None and not e.partial:
		out.update({
			'ltr': _yn(e.ltr) if e.ltr_cap else None,
			'mps': str(e.mps) if e.mps else '',
			'mpscap': str(e.mps_cap) if e.mps_cap else '',
			'mrrs': str(e.mrrs) if e.mrrs else '',
		})
	return out


class _StrictFormatter(string.Formatter):
	"""Formatter that reports, rather than renders, unresolved fields."""

	def __init__(self, values: dict[str, str | None]):
		self.values = values
		self.missing: list[str] = []

	def get_value(self, key, args, kwargs) -> str:
		value = self.values[cast(Any, key)]
		if value is None:
			self.missing.append(f'{key} (inapplicable)')
		elif not value:
			self.missing.append(f'{key} (not determined)')
		return value or ''


def render_format(spec: str, values: dict[str, str | None]) -> str:
	formatter = _StrictFormatter(values)
	try:
		text = formatter.vformat(spec, (), {})
	except (ValueError, KeyError) as exc:
		raise typer.BadParameter(f'bad format string: {exc}') from exc
	return '' if formatter.missing else text


def _md_safe(text: str) -> str:
	"""Escape characters that interfere with Markdown tables."""
	return text.replace('\\', '\\\\').replace('|', '\\|').replace('\n', ' ')


def _note(finding: Finding) -> str:
	mark = SEVERITY_MARKS[finding.severity]
	return f'{mark} {finding.text}' if mark else finding.text


def details(item: Item, quiet: bool, multiline: bool) -> dict[str, str | None]:
	"""Human-readable cells for --table. Unlike :func:`fields`,
	None means 'not determined'.

	:param multiline:
		If True, break notes onto separate lines within the cell, for
		renderers that honour ``<br/>`` in tables.
	"""
	f, v = item.facts, item.verdict
	link, pair = f.link, _pair_of(v)
	# NBSP survives Markdown's trimming of table cells
	indent = '\u00a0\u00a0' * v.depth

	link_cell = cap_cell = aspm_cell = bw_cell = None
	if f.side == 'down' and v.downlink is None:
		link_cell = 'empty'
	elif link is not None and (link.speed is not None or link.width is not None):
		link_cell = fmt_link(link.speed, link.width)
	if pair is not None:
		cap_cell = fmt_link(pair.max_speed, pair.max_width)
		enabled, supported = pair.aspm_states()
		aspm_cell = ' '.join(enabled) or ('off' if supported else 'n/a')
	elif link is not None and link.max_speed is not None:
		cap_cell = fmt_link(link.max_speed, link.max_width)
	if v.bw is not None:
		bw_cell = (
			f'{fmt_gbps(v.bw.available)} / {fmt_gbps(v.bw.capable)}'
			if v.bw.available < v.bw.capable
			else fmt_gbps(v.bw.capable)
		)

	pm = v.dstate
	if f.sys is not None and f.sys.rpm_control:
		pm = f'{pm} {f.sys.rpm_control}'.strip()

	notes = [_note(x) for x in v.findings if not quiet or x.severity > INFO]
	return {
		'Device': indent + f.short,
		'Type': f.kind or 'PCI',
		'Name': _md_safe(_clean_name(f.name)) or None,
		'Driver': f.driver or None,
		'Link': link_cell,
		'Cap': cap_cell,
		'Gb/s': bw_cell,
		'ASPM': aspm_cell,
		'PM': pm or None,
		'Notes': (';<br/>' if multiline else '; ').join(map(_md_safe, notes)) or None,
	}


ALL_DETAILS = [
	'Device',
	'Type',
	'Name',
	'Driver',
	'Link',
	'Cap',
	'Gb/s',
	'ASPM',
	'PM',
	'Notes',
]


def _render_table(header: list[str], rows: list[list[str | None]]) -> str:
	lines = [
		'| '
		+ ' | '.join(cell if cell is not None else '--' for cell in row)
		+ ' |'
		for row in [header, ['---'] * len(header)] + rows
	]
	return '\n'.join(lines)


def render_table_human(items: list[Item], quiet: bool, multiline: bool) -> str:
	rows: list[list[str | None]] = []
	for item in items:
		cells = details(item, quiet, multiline)
		rows.append([cells[key] for key in ALL_DETAILS])
	return _render_table(ALL_DETAILS, rows)


def render_table_verbose(items: list[Item]) -> str:
	rows: list[list[str | None]] = []
	for item in items:
		cells = fields(item)
		rows.append([
			_md_safe(value) if value is not None else None
			for value in (cells[key] for key in ALL_FIELDS)
		])
	return _render_table(ALL_FIELDS, rows)


def _kv(console: Console, key: str, value: str, style: str = '') -> None:
	if value:
		escaped = escape(value)
		printable = f'[{style}]{escaped}[/{style}]' if style else escaped
		console.print(f'    [dim]{key:<16}[/dim] {printable}')


def _sides(pair: Pair, what: Callable[[Any], str]) -> str:
	return f'{pair.up.short}: {what(pair.up)}, {pair.down.short}: {what(pair.down)}'


def _states(states: frozenset[str] | None, order: list[str]) -> str:
	if states is None:
		return '?'
	return ' '.join(s for s in order if s in states) or 'none'


def render_detail(console: Console, item: Item, ctx: Context) -> None:
	f, v = item.facts, item.verdict
	e, link, pair, s = f.express, f.link, _pair_of(v), f.sys
	colour = SEVERITY_COLOURS[v.severity]

	console.print(f'[bold]{escape(f.bdf)}[/bold]  {escape(f.name)}')
	summary = ' · '.join(
		x
		for x in (
			f.cls,
			f'PCIe {e.kind}' if e else 'conventional PCI',
			f.driver or 'no driver',
		)
		if x
	)
	console.print(f'  [{colour}]{escape(summary)}[/{colour}]')

	console.print('\n  [bold]Topology[/bold]')
	_kv(console, 'parent', f'{v.parent.short} ({v.parent.kind or "PCI"})' if v.parent else '(root)')
	if pair is not None:
		peer = pair.down if pair.up is f else pair.up
		_kv(console, 'link peer', f'{peer.short} ({peer.kind}) {_clean_name(peer.name)}')

	if link is not None:
		console.print('\n  [bold]Link[/bold]')
		status = ' '.join(f'{k}{"+" if x else "-"}' for k, x in link.status.items() if x)
		_kv(console, 'status', f'{fmt_link(link.speed, link.width)}  {status}'.strip())
		_kv(console, 'capability', ' '.join(x for x in (
			fmt_link(link.max_speed, link.max_width),
			f'({link.speeds})' if link.speeds else '',
		) if x))
		if pair is not None:
			_kv(console, 'link capability', (
				f'{fmt_link(pair.max_speed, pair.max_width)}  '
				f'[{_sides(pair, lambda x: fmt_link(x.link.max_speed, x.link.max_width))}]'
			))
		if link.target is not None:
			_kv(console, 'target speed', fmt_speed(link.target))

	if v.bw is not None:
		console.print('\n  [bold]Bandwidth[/bold]')
		_kv(console, 'available', f'{fmt_gbps(v.bw.available)} Gb/s')
		_kv(console, 'capable', f'{fmt_gbps(v.bw.capable)} Gb/s')
		if v.bw.available < v.bw.capable:
			_kv(console, 'limited by', f'{fmt_link(v.bw.speed, v.bw.width)} at {v.bw.limiter.short}')
		for msg in dict.fromkeys(m for m in f.klog if KLOG_BANDWIDTH.search(m)):
			_kv(console, 'at enumeration', msg)

	if pair is not None:
		console.print('\n  [bold]ASPM[/bold]')
		if ctx.policy:
			_kv(console, 'policy', ctx.policy + (f' (pcie_aspm={ctx.cmdline})' if ctx.cmdline else ''))
		enabled, supported = pair.aspm_states()
		_kv(console, 'link', f'enabled: {" ".join(enabled) or "none"}; supported: {" ".join(supported) or "none"}')
		_kv(console, 'supported', _sides(pair, lambda x: _states(x.link.aspm_cap, ASPM_STATES)))
		_kv(console, 'enabled', _sides(pair, lambda x: _states(x.link.aspm, ASPM_STATES)))
		_kv(console, 'exit latency', _sides(pair, lambda x: ' '.join(
			f'{k} {fmt_ns(lat)}' for k, lat in x.link.exit_latency.items()
		) or 'n/a'))
		if e is not None and e.acceptable:
			_kv(console, 'acceptable', ' '.join(f'{k} {fmt_ns(lat)}' for k, lat in e.acceptable.items()))
		if pair.up.l1ss and pair.down.l1ss:
			_kv(console, 'L1SS supported', _sides(pair, lambda x: _states(x.l1ss.cap, L1SS_STATES)))
			_kv(console, 'L1SS enabled', _sides(pair, lambda x: _states(x.l1ss.ctl, L1SS_STATES)))
		_kv(console, 'LTR', _sides(pair, lambda x: (
			'?' if x.express.partial
			else ('enabled' if x.express.ltr else 'disabled') if x.express.ltr_cap
			else 'unsupported'
		)))
		if pair.dl.clockpm_cap:
			_kv(console, 'clock PM', 'enabled' if pair.dl.clockpm else 'disabled')
		if not (pair.up.express and pair.up.express.partial) and not (pair.down.express and pair.down.express.partial):
			_kv(console, 'common clock', _yn(pair.ul.commclk and pair.dl.commclk))
		knobs = pair.down.sys.knobs if pair.down.sys else {}
		_kv(console, 'kernel knobs', ' '.join(f'{k}={int(x)}' for k, x in knobs.items()))

	if f.pm is not None or s is not None:
		console.print('\n  [bold]Power[/bold]')
		if s is not None:
			_kv(console, 'state', s.power_state)
			_kv(console, 'runtime PM', ', '.join(x for x in (s.rpm_control, s.rpm_status) if x))
			if s.d3cold_allowed is not None:
				_kv(console, 'D3cold allowed', _yn(s.d3cold_allowed))
		if f.pm is not None:
			_kv(console, 'PM capability', ' '.join(x for x in (
				f'v{f.pm.version}',
				'D1' if f.pm.d1 else '',
				'D2' if f.pm.d2 else '',
				'NoSoftRst' if f.pm.no_soft_reset else '',
			) if x))
			_kv(console, 'PME from', ' '.join(f.pm.pme) or 'none')
			if s is None:
				_kv(console, 'state', f.pm.state)

	if e is not None and e.mps is not None:
		console.print('\n  [bold]Transactions[/bold]')
		_kv(console, 'max payload', f'{e.mps} (supported {e.mps_cap})')
		_kv(console, 'max read req', str(e.mrrs or ''))

	aer = s.aer if s else {}
	if f.ce_status or f.ue_status or any(c.get(k) for c in aer.values() for k in c):
		console.print('\n  [bold]Errors[/bold]')
		for kind, counters in aer.items():
			_kv(console, kind, ' '.join(f'{k}={n}' for k, n in counters.items() if n))
		_kv(console, 'CESta', ' '.join(f.ce_status))
		_kv(console, 'UESta', ' '.join(f.ue_status))

	if f.rebar:
		console.print('\n  [bold]Resizable BARs[/bold]')
		for bar, current, largest in f.rebar:
			_kv(console, f'BAR {bar}', f'{fmt_size(current)} (up to {fmt_size(largest)})')

	if f.klog:
		console.print('\n  [bold]Kernel log[/bold]  [dim](this boot)[/dim]')
		for msg, n in Counter(f.klog).most_common(10):
			count = f'[dim]{n}×[/dim] ' if n > 1 else ''
			console.print(f'      {count}{escape(msg)}')

	if v.findings:
		console.print('\n  [bold]Findings[/bold]')
		for x in v.findings:
			mark = {INFO: '[dim]·[/dim]', WARN: '[yellow]![/yellow]', ERROR: '[red]!![/red]'}[x.severity]
			console.print(f'    {mark} {escape(x.text)}')
	console.print()


# --------------------------------------------------------------------------
# CLI
# --------------------------------------------------------------------------

app = typer.Typer(
	add_completion=False,
	context_settings={'help_option_names': ['-h', '--help']},
)

MARKDOWN_RENDERER_FMT = 'glow -w{columns}'

g_markdown_renderer_installed = None


def _isatty_cols(file: IO[str] | None) -> Optional[int]:
	"""Checks if the given file is a TTY and returns the number of columns if so."""
	if file and file.isatty():
		return shutil.get_terminal_size().columns
	return None


def _ensure_markdown_renderer(markdown: bool, markdown_tool: Optional[str]):
	global g_markdown_renderer_installed

	stdout_cols = _isatty_cols(sys.stdout)
	if markdown and g_markdown_renderer_installed is None and stdout_cols is not None:
		markdown_tool = (markdown_tool or MARKDOWN_RENDERER_FMT).format(columns=stdout_cols)
		pipe_fd = os.pipe()
		sub = subprocess.Popen(
			shlex.split(markdown_tool),
			stdin=os.fdopen(pipe_fd[0], 'r'),
			text=True,
		)
		sys.stdout = os.fdopen(pipe_fd[1], 'w')
		g_markdown_renderer_installed = sub


def _finish_markdown_renderer():
	"""Hand the renderer EOF and wait for it, so that its output is not
	interleaved with whatever runs after this process exits."""
	if g_markdown_renderer_installed is not None:
		sys.stdout.close()
		g_markdown_renderer_installed.wait()


def _selected(f: Facts, selectors: list[str]) -> bool:
	return not selectors or any(
		f.bdf.startswith(sel) or f.short.startswith(sel)
		for sel in map(str.lower, selectors)
	)


@app.command()
def main(
	fmt: Annotated[
		list[str],
		typer.Option(
			'--format',
			'-f',
			help=(
				f'Emit a format string per device instead of a report. '
				f'Output is omitted entirely if any referenced field is unknown. '
				f'Fields: {FIELD_HELP}'
			),
			default_factory=list,
			show_default=False,
		),
	],
	devices: Annotated[
		Optional[list[str]],
		typer.Argument(
			help='Devices to report on: a BDF or a prefix of one (e.g. "01:00", "0000:03:"). Default: all.',
			show_default=False,
		),
	] = None,
	input: Annotated[
		Optional[Path],
		typer.Option(
			'--input',
			'-i',
			help='Analyse saved `lspci -vvv` output ("-" for stdin) instead of this machine.',
		),
	] = None,
	table: Annotated[
		Optional[bool],
		typer.Option(
			'--table/--detail',
			'-t/-l',
			help='Force markdown table or detailed report (default: table for >1 device).',
		),
	] = None,
	markdown: Annotated[
		bool,
		typer.Option(
			'--markdown',
			'-M',
			help=f'Render markdown output, if needed, using a given tool (default: `{MARKDOWN_RENDERER_FMT}`)',
		),
	] = False,
	markdown_tool: Annotated[
		Optional[str],
		typer.Option(
			'--markdown-tool',
			help=f'Use TOOL instead of `{MARKDOWN_RENDERER_FMT}` to render markdown output on a terminal',
		),
	] = None,
	verbose: Annotated[
		bool,
		typer.Option(
			'--verbose',
			'-v',
			help='Display raw fields instead of human-readable summary table.',
		),
	] = False,
	all_devices: Annotated[
		bool,
		typer.Option(
			'--all',
			'-a',
			help='Include conventional PCI devices and functions without a PCIe link.',
		),
	] = False,
	problems: Annotated[
		bool,
		typer.Option(
			'--problems',
			'-p',
			help='Only report devices with warnings or errors.',
		),
	] = False,
	quiet: Annotated[
		bool,
		typer.Option(
			'--quiet',
			'-q',
			help='Omit informational notes from the table.',
		),
	] = False,
	no_wake: Annotated[
		bool,
		typer.Option(
			'--no-wake',
			'-W',
			help=(
				'Do not read config space of devices where doing so would resume them '
				'(runtime-suspended parent, or D3cold); report what sysfs knows instead.'
			),
		),
	] = False,
	debug: Annotated[
		bool,
		typer.Option('--debug', help='Log parser diagnostics.'),
	] = False,
) -> None:
	"""Report PCIe link speed/width, end-to-end bandwidth, ASPM and power
	management state of PCI devices, and flag anything suboptimal.

	By default, this machine is probed with `lspci -vvv` (run as root for
	complete data), sysfs and the kernel log. Power states are captured before
	lspci runs, as reading config space resumes suspended devices.
	"""
	structlog.configure(
		processors=[
			structlog.processors.add_log_level,
			structlog.dev.ConsoleRenderer(colors=sys.stderr.isatty()),
		],
		logger_factory=structlog.PrintLoggerFactory(sys.stderr),
		wrapper_class=structlog.make_filtering_bound_logger(
			logging.DEBUG if debug else logging.WARNING
		),
	)

	if input is not None:
		text = sys.stdin.read() if str(input) == '-' else input.read_text()
		facts = parse_lspci(text)
		ctx = Context()
	else:
		facts = probe_live(no_wake)
		ctx = probe_context()

	items = [
		item
		for item in analyse(facts, ctx)
		if _selected(item.facts, devices or [])
		and (all_devices or devices or item.facts.link is not None)
		and (not problems or item.verdict.severity >= WARN)
	]
	if not items:
		raise typer.Exit(1)

	if fmt:
		for item in items:
			values = fields(item)
			line = ' '.join(filter(None, (render_format(f, values) for f in fmt)))
			if line:
				print(line)
		return

	if table if table is not None else len(items) > 1:
		_ensure_markdown_renderer(markdown, markdown_tool)
		if verbose:
			print(render_table_verbose(items))
		else:
			print(render_table_human(items, quiet, g_markdown_renderer_installed is not None))
		_finish_markdown_renderer()
		return

	console = Console(highlight=False, soft_wrap=True)
	for item in items:
		render_detail(console, item, ctx)


if __name__ == '__main__':
	app()
