#!/bin/bash

set -eo pipefail
shopt -s lastpipe
shopt -s nullglob

log() {
	echo ":: $*" >&2
}

err() {
	echo "E: $*" >&2
}

die() {
	err "$@"
	exit 1
}

usage() {
	if (( $# )); then
		echo "${0##*/}: $*" >&2
		echo >&2
	fi
	_usage >&2
	exit 1
}

_usage() {
	cat <<EOF
Usage: ${0##*/} [OPTIONS...]

Opinionated \`git gc\` / \`git repack\` wrapper to optimize git repositories
in a way that minimizes churn (useful for taking incremental backups).

All packs that are newer than a preset time and/or smaller than a preset size
are repacked together with no object or delta reuse, and all other packs are
preserved. The largest pack is always kept. This preserves the "append-mostly"
nature of Git packs while removing excess redundancy in recently created packs.

This is intended as a post-fetch pass to coalesce heavily redundant packs and
get rid of bad deltas after fetching from a large number of unrelated remotes
(as is common in large integration trees, e.g. Linux kernel).

By default, this script uses cruft packs (\`git repack --cruft\`) and preserves
all reflogs and unreachable objects.

Options:
	-S, --size=SIZE			Consider packs less than SIZE bytes.
	-T, --time=TIME			Consider packs newer than absolute TIME.
	-s, --seconds=SECONDS		Consider packs not more than SECONDS old.
	-f, --force			Force repacking, even if there is
					less than two candidate packs
					(useful for packing loose objects).
	-m, --midx			Write a multi-pack index.
	-b, --bitmap			Write a bitmap index (only makes sense
					with either \`--all\` or \`--midx\`).

Modes of operation:
	--gc				Use \`git gc\` instead of \`git repack\`
					and aggressively prune unreachable objects.
	--gc-no-prune			Use \`git gc\` instead of \`git repack\`,
					but do not prune any objects.
	-g				Use geometric repack (\`git repack -g2\`)
					instead of the default \`git repack --cruft\`.
	--all				Force repacking of *ALL* packs with
					no exclusions (for infrequent use).
	--all-reuse			Force repacking of *ALL* packs, but
					keep delta/object reuse on
					(for extremely large repos).
EOF
}


#
# git-gc-fetch -- `git gc` after fetching many redundant packs
#


#
# args
#

now="$(date +%s)"
SMALL_PACK_BYTES="$(( 100*1024*1024 ))"
OLD_PACK_TIME="$(( now - 24*3600 ))"
GIT_GC=0
GIT_GC_NO_PRUNE=0
GIT_GEOMETRIC=0
FORCE=0
GIT_REPACK_ARGS=()
GIT_GC_KEEP_LARGEST_PACK=( --keep-largest-pack )
GIT_REPACK_NO_REUSE=( -fF )
ALL=0

GIT_REPACK_CFG=(
	-c pack.depth=50
	-c pack.window=1000
	-c pack.compression=9
	-c pack.allowPackReuse=multi
)
GIT_GC_CFG=(
	-c gc.writeCommitGraph=true
)

if args=$(getopt -o '+S:T:s:gbmfh' --long 'all,all-reuse,size:,time:,seconds:,gc,gc-no-prune,geometric,bitmap,midx,force,help' -n "${0##*/}" -- "$@"); then
	eval set -- "$args"
else
	usage
fi
unset args

while :; do
	case "$1" in
	-h|--help) usage ;;
	-S|--size) shift; SMALL_PACK_BYTES="$(bscalcq -b "$1")" ;;
	-T|--time) shift; OLD_PACK_TIME="$(date -d "$1" +%s)" ;;
	-s|--seconds) shift; OLD_PACK_TIME="$(( now - "$1" ))" ;;
	--gc) GIT_GC=1 ;;
	--gc-no-prune) GIT_GC_NO_PRUNE=1 ;;
	-g|--geometric) GIT_GEOMETRIC=1 ;;
	-b|--bitmap) GIT_REPACK_ARGS+=( --write-bitmap-index ) ;;
	-m|--midx) GIT_REPACK_ARGS+=( --write-midx ) ;;
	-f|--force) FORCE=1 ;;
	--all-reuse) GIT_REPACK_NO_REUSE=() ;&
	--all) ALL=1; GIT_GC_KEEP_LARGEST_PACK=() ;;
	--) shift; break ;;
	*) die "getopt error" ;;
	esac
	shift
done

# case "$#" in
# 0) ;;
# *) usage "wrong number of positional arguments" ;;
# esac


#
# functions
#

join() {
	local IFS
	IFS="$1"
	shift
	echo "$*"
}


#
# main
#

GIT_DIR="$(git rev-parse --git-common-dir)"

cleanup() {
	rm -f "$GIT_DIR/objects/pack"/*.keep
}
trap cleanup EXIT

declare -a PACKS

find "$GIT_DIR/objects/pack" \
	-type f \
	\( -name '*.pack' -or -name 'tmp_pack_*' \) \
| while read pack; do

	mtime="$(stat -c '%Y' "$pack")"
	size="$(stat -c '%s' "$pack")"

	# HACK: use the older of .pack and .idx mtimes.
	# Sometimes, `git fetch` touches old packs for no good reason, breaking
	# this logic.
	if [[ $pack == *.pack ]]; then
		idx="${pack%.pack}.idx"
		mtime_pack="$mtime"
		mtime_idx="$(stat -c '%Y' "$idx")"
		mtime="$(( mtime_idx < mtime_pack ? mtime_idx : mtime_pack ))"
	fi

	PACKS+=(
		"$(join $'\t' "$mtime" "$size" "$pack")"
	)
done

if ! [[ ${PACKS+set} ]]; then
	echo "Nothing to pack"
	exit
fi

CANDIDATES=0

if (( ! GIT_GEOMETRIC ))
then _sort_args=(-k1)     # by mtime, ascending
else _sort_args=(-k2 -r)  # by size, descending
fi

NR=0
printf "%s\n" "${PACKS[@]}" \
| sort -n -t $'\t' "${_sort_args[@]}" \
| while read -r mtime size pack; do

	idx="${pack%.pack}.idx"

	human_size="$(du --human-readable --apparent-size "$pack" | cut -d$'\t' -f1)"
	human_mtime="$(date -d "@$mtime")"

	if [[ $pack == */tmp_pack_* ]]; then
		echo "Temporary pack, forcing: ${pack##*/} @ $human_size ($human_mtime)"
		(( ++CANDIDATES ))
		FORCE=1
		continue
	fi

	cruft="${pack%.pack}.mtimes"
	if [[ -e $cruft ]]; then
		echo "Skipping cruft pack: ${pack##*/} @ $human_size ($human_mtime)"
		continue
	fi

	# if --all is passed, repack everything
	if (( ALL )); then
		repack=1

	# in geometric mode, repack everything after the largest pack
	elif (( GIT_GEOMETRIC && NR > 0 )); then
		repack=1

	# repack everything after the first candidate pack
	elif (( CANDIDATES )); then
		repack=1

	# repack all recent packs
	elif (( mtime > OLD_PACK_TIME )); then
		repack=1

	# do not bother keeping very small packs
	elif (( size < SMALL_PACK_BYTES )); then
		repack=1

	# keep the rest
	else
		repack=0
	fi

	if (( repack )); then
		echo "Repacking: ${pack##*/} @ $human_size ($human_mtime)"
		(( ++CANDIDATES ))
	else
		echo "Keeping pack: ${pack##*/} @ $human_size ($human_mtime)"
		touch "${pack%.pack}.keep"
	fi

	(( ++NR ))
done

if (( !FORCE && CANDIDATES < 2 )); then
	echo "Nothing to repack"
	exit
fi

if (( GIT_GC || GIT_GC_NO_PRUNE )); then
	if (( ! GIT_GC_NO_PRUNE ))
	then
		_git_gc_cfg=(
			-c gc.pruneExpire=now
		); _git_gc_args=(
			--prune=now
		)
	else
		_git_gc_cfg=(
			-c gc.cruftPacks=true
			-c gc.pruneExpire=never
			-c gc.reflogExpire=never
			-c gc.reflogExpireUnreachable=never
		); _git_gc_args=(
			--no-prune
		)
	fi
	git \
		"${GIT_REPACK_CFG[@]}" \
		"${GIT_GC_CFG[@]}" \
		"${_git_gc_cfg[@]}"
		gc \
		"${GIT_GC_KEEP_LARGEST_PACK[@]}" \
		"${_git_gc_args[@]}" \
		"$@"
else
	if (( ! GIT_GEOMETRIC ))
	then _git_repack_args=( --cruft )
	else _git_repack_args=( -g2 )
	fi
	git \
		"${GIT_REPACK_CFG[@]}" \
		repack \
		"${_git_repack_args[@]}" -d -l \
		"${GIT_REPACK_NO_REUSE[@]}" \
		"${GIT_REPACK_ARGS[@]}" \
		"$@"
	# git \
	# 	multi-pack-index \
	# 	write \
	# 	--bitmap
	git \
		commit-graph \
		write \
		--reachable \
		--changed-paths
fi

rm -vf "$GIT_DIR/objects/pack"/tmp_pack_*
